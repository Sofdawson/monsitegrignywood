    "custom_liquid_LxwRcf": {
      "type": "custom-liquid",
      "name": "Custom Liquid",
      "settings": {
        "full_width": true,
        "remove_vertical_spacing": false,
        "remove_horizontal_spacing": false,
        "liquid": "<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Archivo:ital,wght@0,600;0,700;1,900&display=swap\">\n\n<div class=\"gwa\">\n  <h2 class=\"gwa-title\">Ils l'ont adopté, et ils le disent mieux que nous</h2>\n\n  <!-- ⚠️ AVIS D'EXEMPLE — CONTENU FICTIF, NE PAS METTRE EN LIGNE TEL QUEL ⚠️ -->\n\n  <div class=\"gwa-grid\">\n\n    <article class=\"gwa-card\">\n      <img class=\"gwa-photo\" src=\"https://cdn.shopify.com/s/files/1/0980/1724/7556/files/ChatGPT_Image_21_sept._2026_21_06_40.png?v=1790018805\" alt=\"\" loading=\"lazy\">\n      <div class=\"gwa-panel\">\n        <div class=\"gwa-stars\" aria-label=\"5 sur 5\">\n          <svg viewBox=\"0 0 24 24\"><path d=\"m12 2 3.1 6.3 6.9 1-5 4.9 1.2 6.8L12 17.8 5.8 21l1.2-6.8-5-4.9 6.9-1z\"/></svg>\n          <svg viewBox=\"0 0 24 24\"><path d=\"m12 2 3.1 6.3 6.9 1-5 4.9 1.2 6.8L12 17.8 5.8 21l1.2-6.8-5-4.9 6.9-1z\"/></svg>\n          <svg viewBox=\"0 0 24 24\"><path d=\"m12 2 3.1 6.3 6.9 1-5 4.9 1.2 6.8L12 17.8 5.8 21l1.2-6.8-5-4.9 6.9-1z\"/></svg>\n          <svg viewBox=\"0 0 24 24\"><path d=\"m12 2 3.1 6.3 6.9 1-5 4.9 1.2 6.8L12 17.8 5.8 21l1.2-6.8-5-4.9 6.9-1z\"/></svg>\n          <svg viewBox=\"0 0 24 24\"><path d=\"m12 2 3.1 6.3 6.9 1-5 4.9 1.2 6.8L12 17.8 5.8 21l1.2-6.8-5-4.9 6.9-1z\"/></svg>\n        </div>\n        <h3>«&nbsp;Mon argent sert à quelque chose&nbsp;»</h3>\n        <p>Je voulais juste un t-shirt, j'ai fini par soutenir un projet. Savoir où va l'argent, ça change complètement le rapport à l'achat.</p>\n        <div class=\"gwa-who\">\n          <img class=\"gwa-av\" src=\"https://cdn.shopify.com/s/files/1/0980/1724/7556/files/ChatGPT_Image_21_sept._2026_21_06_40.png?v=1790018805\" alt=\"\" loading=\"lazy\">\n          <div><strong>Mehdi</strong><em>42 ans · Nantes</em></div>\n        </div>\n      </div>\n    </article>\n\n    <article class=\"gwa-card\">\n      <img class=\"gwa-photo\" src=\"https://cdn.shopify.com/s/files/1/0980/1724/7556/files/ChatGPT_Image_21_sept._2026_21_05_23.png?v=1790018804\" alt=\"\" loading=\"lazy\">\n      <div class=\"gwa-panel\">\n        <div class=\"gwa-stars\" aria-label=\"5 sur 5\">\n          <svg viewBox=\"0 0 24 24\"><path d=\"m12 2 3.1 6.3 6.9 1-5 4.9 1.2 6.8L12 17.8 5.8 21l1.2-6.8-5-4.9 6.9-1z\"/></svg>\n          <svg viewBox=\"0 0 24 24\"><path d=\"m12 2 3.1 6.3 6.9 1-5 4.9 1.2 6.8L12 17.8 5.8 21l1.2-6.8-5-4.9 6.9-1z\"/></svg>\n          <svg viewBox=\"0 0 24 24\"><path d=\"m12 2 3.1 6.3 6.9 1-5 4.9 1.2 6.8L12 17.8 5.8 21l1.2-6.8-5-4.9 6.9-1z\"/></svg>\n          <svg viewBox=\"0 0 24 24\"><path d=\"m12 2 3.1 6.3 6.9 1-5 4.9 1.2 6.8L12 17.8 5.8 21l1.2-6.8-5-4.9 6.9-1z\"/></svg>\n          <svg viewBox=\"0 0 24 24\"><path d=\"m12 2 3.1 6.3 6.9 1-5 4.9 1.2 6.8L12 17.8 5.8 21l1.2-6.8-5-4.9 6.9-1z\"/></svg>\n        </div>\n        <h3>«&nbsp;J'achète, ils construisent&nbsp;»</h3>\n        <p>C'est la première fois que je commande un vêtement en sachant exactement ce qu'il finance. Je recommanderai à chaque collection.</p>\n        <div class=\"gwa-who\">\n          <img class=\"gwa-av\" src=\"https://cdn.shopify.com/s/files/1/0980/1724/7556/files/ChatGPT_Image_21_sept._2026_21_05_23.png?v=1790018804\" alt=\"\" loading=\"lazy\">\n          <div><strong>Sabrina</strong><em>39 ans · Toulouse</em></div>\n        </div>\n      </div>\n    </article>\n\n    <article class=\"gwa-card\">\n      <img class=\"gwa-photo\" src=\"https://cdn.shopify.com/s/files/1/0980/1724/7556/files/ChatGPT_Image_21_sept._2026_21_16_49.png?v=1790018805\" alt=\"\" loading=\"lazy\">\n      <div class=\"gwa-panel\">\n        <div class=\"gwa-stars\" aria-label=\"5 sur 5\">\n          <svg viewBox=\"0 0 24 24\"><path d=\"m12 2 3.1 6.3 6.9 1-5 4.9 1.2 6.8L12 17.8 5.8 21l1.2-6.8-5-4.9 6.9-1z\"/></svg>\n          <svg viewBox=\"0 0 24 24\"><path d=\"m12 2 3.1 6.3 6.9 1-5 4.9 1.2 6.8L12 17.8 5.8 21l1.2-6.8-5-4.9 6.9-1z\"/></svg>\n          <svg viewBox=\"0 0 24 24\"><path d=\"m12 2 3.1 6.3 6.9 1-5 4.9 1.2 6.8L12 17.8 5.8 21l1.2-6.8-5-4.9 6.9-1z\"/></svg>\n          <svg viewBox=\"0 0 24 24\"><path d=\"m12 2 3.1 6.3 6.9 1-5 4.9 1.2 6.8L12 17.8 5.8 21l1.2-6.8-5-4.9 6.9-1z\"/></svg>\n          <svg viewBox=\"0 0 24 24\"><path d=\"m12 2 3.1 6.3 6.9 1-5 4.9 1.2 6.8L12 17.8 5.8 21l1.2-6.8-5-4.9 6.9-1z\"/></svg>\n        </div>\n        <h3>«&nbsp;C'est ma ville que je porte&nbsp;»</h3>\n        <p>J'ai grandi là-bas, je n'y habite plus depuis quinze ans. Porter ce logo, c'est dire d'où je viens sans avoir à l'expliquer.</p>\n        <div class=\"gwa-who\">\n          <img class=\"gwa-av\" src=\"https://cdn.shopify.com/s/files/1/0980/1724/7556/files/ChatGPT_Image_21_sept._2026_21_16_49.png?v=1790018805\" alt=\"\" loading=\"lazy\">\n          <div><strong>ERIC</strong><em>48 ans · Bourges</em></div>\n        </div>\n      </div>\n    </article>\n\n    <article class=\"gwa-card\">\n      <img class=\"gwa-photo\" src=\"https://cdn.shopify.com/s/files/1/0980/1724/7556/files/ChatGPT_Image_21_sept._2026_21_10_36.png?v=1790018804\" alt=\"\" loading=\"lazy\">\n      <div class=\"gwa-panel\">\n        <div class=\"gwa-stars\" aria-label=\"5 sur 5\">\n          <svg viewBox=\"0 0 24 24\"><path d=\"m12 2 3.1 6.3 6.9 1-5 4.9 1.2 6.8L12 17.8 5.8 21l1.2-6.8-5-4.9 6.9-1z\"/></svg>\n          <svg viewBox=\"0 0 24 24\"><path d=\"m12 2 3.1 6.3 6.9 1-5 4.9 1.2 6.8L12 17.8 5.8 21l1.2-6.8-5-4.9 6.9-1z\"/></svg>\n          <svg viewBox=\"0 0 24 24\"><path d=\"m12 2 3.1 6.3 6.9 1-5 4.9 1.2 6.8L12 17.8 5.8 21l1.2-6.8-5-4.9 6.9-1z\"/></svg>\n          <svg viewBox=\"0 0 24 24\"><path d=\"m12 2 3.1 6.3 6.9 1-5 4.9 1.2 6.8L12 17.8 5.8 21l1.2-6.8-5-4.9 6.9-1z\"/></svg>\n          <svg viewBox=\"0 0 24 24\"><path d=\"m12 2 3.1 6.3 6.9 1-5 4.9 1.2 6.8L12 17.8 5.8 21l1.2-6.8-5-4.9 6.9-1z\"/></svg>\n        </div>\n        <h3>«&nbsp;On se reconnaît dans la rue&nbsp;»</h3>\n        <p>J'ai croisé quelqu'un avec le même à la gare Saint-Charles. On s'est fait un signe sans se connaître, à 800 kilomètres de Grigny. C'est exactement ce que la marque fabrique.</p>\n        <div class=\"gwa-who\">\n          <img class=\"gwa-av\" src=\"https://cdn.shopify.com/s/files/1/0980/1724/7556/files/ChatGPT_Image_21_sept._2026_21_10_36.png?v=1790018804\" alt=\"\" loading=\"lazy\">\n          <div><strong>Fatou</strong><em>36 ans · Marseille</em></div>\n        </div>\n      </div>\n    </article>\n\n    <article class=\"gwa-card\">\n      <img class=\"gwa-photo\" src=\"https://cdn.shopify.com/s/files/1/0980/1724/7556/files/ChatGPT_Image_21_sept._2026_21_19_58.png?v=1790018804\" alt=\"\" loading=\"lazy\">\n      <div class=\"gwa-panel\">\n        <div class=\"gwa-stars\" aria-label=\"5 sur 5\">\n          <svg viewBox=\"0 0 24 24\"><path d=\"m12 2 3.1 6.3 6.9 1-5 4.9 1.2 6.8L12 17.8 5.8 21l1.2-6.8-5-4.9 6.9-1z\"/></svg>\n          <svg viewBox=\"0 0 24 24\"><path d=\"m12 2 3.1 6.3 6.9 1-5 4.9 1.2 6.8L12 17.8 5.8 21l1.2-6.8-5-4.9 6.9-1z\"/></svg>\n          <svg viewBox=\"0 0 24 24\"><path d=\"m12 2 3.1 6.3 6.9 1-5 4.9 1.2 6.8L12 17.8 5.8 21l1.2-6.8-5-4.9 6.9-1z\"/></svg>\n          <svg viewBox=\"0 0 24 24\"><path d=\"m12 2 3.1 6.3 6.9 1-5 4.9 1.2 6.8L12 17.8 5.8 21l1.2-6.8-5-4.9 6.9-1z\"/></svg>\n          <svg viewBox=\"0 0 24 24\"><path d=\"m12 2 3.1 6.3 6.9 1-5 4.9 1.2 6.8L12 17.8 5.8 21l1.2-6.8-5-4.9 6.9-1z\"/></svg>\n        </div>\n        <h3>«&nbsp;Le 350 g, ça se sent tout de suite&nbsp;»</h3>\n        <p>Rien à voir avec les tee-shirts fins que j'avais avant. Il a du corps, il tombe bien, et il n'a pas bougé après une dizaine de lavages.</p>\n        <div class=\"gwa-who\">\n          <img class=\"gwa-av\" src=\"https://cdn.shopify.com/s/files/1/0980/1724/7556/files/ChatGPT_Image_21_sept._2026_21_19_58.png?v=1790018804\" alt=\"\" loading=\"lazy\">\n          <div><strong>Thomas</strong><em>51 ans · Brest</em></div>\n        </div>\n      </div>\n    </article>\n\n    <article class=\"gwa-card\">\n      <img class=\"gwa-photo\" src=\"https://cdn.shopify.com/s/files/1/0980/1724/7556/files/ChatGPT_Image_21_sept._2026_21_22_13.png?v=1790018804\" alt=\"\" loading=\"lazy\">\n      <div class=\"gwa-panel\">\n        <div class=\"gwa-stars\" aria-label=\"5 sur 5\">\n          <svg viewBox=\"0 0 24 24\"><path d=\"m12 2 3.1 6.3 6.9 1-5 4.9 1.2 6.8L12 17.8 5.8 21l1.2-6.8-5-4.9 6.9-1z\"/></svg>\n          <svg viewBox=\"0 0 24 24\"><path d=\"m12 2 3.1 6.3 6.9 1-5 4.9 1.2 6.8L12 17.8 5.8 21l1.2-6.8-5-4.9 6.9-1z\"/></svg>\n          <svg viewBox=\"0 0 24 24\"><path d=\"m12 2 3.1 6.3 6.9 1-5 4.9 1.2 6.8L12 17.8 5.8 21l1.2-6.8-5-4.9 6.9-1z\"/></svg>\n          <svg viewBox=\"0 0 24 24\"><path d=\"m12 2 3.1 6.3 6.9 1-5 4.9 1.2 6.8L12 17.8 5.8 21l1.2-6.8-5-4.9 6.9-1z\"/></svg>\n          <svg viewBox=\"0 0 24 24\"><path d=\"m12 2 3.1 6.3 6.9 1-5 4.9 1.2 6.8L12 17.8 5.8 21l1.2-6.8-5-4.9 6.9-1z\"/></svg>\n        </div>\n        <h3>«&nbsp;Je ne suis pas de Grigny, et alors&nbsp;?&nbsp;»</h3>\n        <p>J'ai hésité en me disant que c'était réservé à ceux du coin. En fait pas du tout : c'est une fierté qui parle à tout le monde.</p>\n        <div class=\"gwa-who\">\n          <img class=\"gwa-av\" src=\"https://cdn.shopify.com/s/files/1/0980/1724/7556/files/ChatGPT_Image_21_sept._2026_21_22_13.png?v=1790018804\" alt=\"\" loading=\"lazy\">\n          <div><strong>Camille</strong><em>44 ans · Carcassonne</em></div>\n        </div>\n      </div>\n    </article>\n\n  </div>\n</div>\n\n<style>\n.gwa{\n  /* ================= RÉGLAGES ================= */\n  --gw-ink:#111111;\n  --gw-bg:#FFFFFF;\n  --gw-card-bg:#FFFFFF;\n  --gw-photo-bg:#EEEEEE;\n\n  --gw-frame:#111111;\n  --gw-frame-w:1.5px;\n  --gw-radius:14px;\n\n  --gw-neon:#F7A81B;\n  --gw-neon-rgb:247,168,27;\n  --gw-halo-0:.45;\n  --gw-halo-1:.50;\n  --gw-halo-2:.32;\n  --gw-halo-3:.18;\n\n  --gw-max:1760px;\n  --gw-card-w:84vw;\n  --gw-photo-h:42vh;            /* hauteur de la photo sur mobile */\n  --gw-photo-pos:center 12%;    /* cadrage : baisser le % remonte le cadrage */\n  /* ============================================ */\n\n  background:var(--gw-bg);\n  color:var(--gw-ink);\n  padding:60px 24px 68px;\n  box-sizing:border-box;\n  font-family:'Archivo',system-ui,sans-serif;\n}\n.gwa *{box-sizing:border-box;}\n\n/* svh tient compte de la barre d'adresse du navigateur mobile */\n@supports (height:1svh){\n  .gwa{--gw-photo-h:42svh;}\n}\n\n.gwa-title{\n  font-family:'Archivo',system-ui,sans-serif;\n  font-weight:900;font-style:italic;text-transform:uppercase;\n  text-align:center;color:var(--gw-ink);\n  font-size:clamp(22px,3.4vw,38px);\n  line-height:1.05;letter-spacing:-0.015em;\n  text-wrap:balance;\n  margin:0 0 46px;\n}\n\n.gwa-grid{\n  display:grid;\n  grid-template-columns:1fr;\n  gap:26px;\n  max-width:var(--gw-max);\n  margin:0 auto;\n}\n\n.gwa-card{\n  display:flex;\n  height:100%;\n  background:var(--gw-card-bg);\n  border:var(--gw-frame-w) solid var(--gw-frame);\n  border-radius:var(--gw-radius);\n  overflow:hidden;\n  box-shadow:\n    0 0 0 1px rgba(var(--gw-neon-rgb),var(--gw-halo-0)),\n    0 0 10px rgba(var(--gw-neon-rgb),var(--gw-halo-1)),\n    0 0 26px rgba(var(--gw-neon-rgb),var(--gw-halo-2)),\n    0 0 52px rgba(var(--gw-neon-rgb),var(--gw-halo-3));\n}\n\n.gwa-photo{\n  flex:0 0 40%;\n  width:40%;\n  align-self:stretch;\n  min-height:280px;\n  object-fit:cover;\n  object-position:var(--gw-photo-pos);\n  display:block;\n  background:var(--gw-photo-bg);\n  border-right:var(--gw-frame-w) solid var(--gw-frame);\n}\n\n.gwa-panel{\n  flex:1;\n  min-width:0;\n  padding:24px 26px;\n  display:flex;flex-direction:column;\n}\n\n.gwa-stars{display:flex;gap:3px;margin-bottom:14px;}\n.gwa-stars svg{\n  width:19px;height:19px;\n  fill:var(--gw-neon);\n  filter:drop-shadow(0 0 4px rgba(var(--gw-neon-rgb),.55));\n}\n\n.gwa-panel h3{\n  margin:0 0 12px;\n  font-family:'Archivo',system-ui,sans-serif;\n  font-weight:900;font-style:italic;text-transform:uppercase;\n  font-size:clamp(17px,1.5vw,22px);\n  line-height:1.15;letter-spacing:-0.015em;\n  text-wrap:balance;\n  color:var(--gw-ink);\n}\n.gwa-panel p{\n  margin:0 0 22px;\n  font-family:'Archivo',system-ui,sans-serif;\n  font-weight:600;font-style:normal;\n  font-size:15px;line-height:1.5;\n  color:var(--gw-ink);\n}\n\n.gwa-who{\n  margin-top:auto;\n  display:flex;align-items:center;gap:12px;\n}\n.gwa-av{\n  flex:0 0 auto;\n  width:44px;height:44px;border-radius:50%;\n  object-fit:cover;\n  object-position:center top;\n  background:var(--gw-photo-bg);\n  border:var(--gw-frame-w) solid var(--gw-frame);\n  display:block;\n}\n\n.gwa-who strong{\n  display:block;\n  font-family:'Archivo',system-ui,sans-serif;\n  font-weight:900;font-style:italic;text-transform:uppercase;\n  font-size:16px;letter-spacing:-0.01em;\n  color:var(--gw-ink);\n}\n.gwa-who em{\n  display:block;font-style:normal;font-weight:600;font-size:13px;\n  color:var(--gw-ink);\n}\n\n@media(min-width:1000px){\n  .gwa-grid{\n    grid-template-columns:repeat(3,1fr);\n    grid-auto-rows:1fr;\n    gap:34px;\n  }\n  .gwa-panel{padding:26px 30px;}\n}\n\n@media(min-width:700px) and (max-width:999px){\n  .gwa-grid{\n    grid-template-columns:repeat(2,1fr);\n    grid-auto-rows:1fr;\n    gap:30px;\n  }\n}\n\n/* --- MOBILE : la carte entière doit tenir dans l'écran --- */\n@media(max-width:699px){\n  .gwa{\n    padding:40px 0 46px;\n    width:100vw;max-width:100vw;\n    margin-left:calc(50% - 50vw);\n    margin-right:calc(50% - 50vw);\n  }\n  .gwa-title{margin:0 20px 26px;}\n\n  .gwa-grid{\n    display:flex;\n    flex-direction:row;\n    gap:18px;\n    max-width:none;\n    padding:6px 16px 10px;\n    overflow-x:auto;\n    overflow-y:hidden;\n    scroll-snap-type:x mandatory;\n    -webkit-overflow-scrolling:touch;\n    scrollbar-width:none;\n  }\n  .gwa-grid::-webkit-scrollbar{display:none;}\n\n  .gwa-card{\n    flex:0 0 var(--gw-card-w);\n    scroll-snap-align:center;\n    flex-direction:column;\n    height:auto;\n  }\n\n  /* !important : certains thèmes forcent img{height:auto} en global */\n  .gwa .gwa-photo{\n    flex:0 0 auto !important;\n    width:100% !important;\n    aspect-ratio:auto !important;\n    height:var(--gw-photo-h) !important;\n    min-height:190px !important;\n    max-height:400px !important;\n    object-fit:cover !important;\n    object-position:var(--gw-photo-pos) !important;\n    border-right:none;\n    border-bottom:var(--gw-frame-w) solid var(--gw-frame);\n  }\n\n  .gwa-panel{padding:15px 16px 17px;}\n  .gwa-stars{margin-bottom:9px;}\n  .gwa-stars svg{width:16px;height:16px;}\n  .gwa-panel h3{font-size:17px;line-height:1.12;margin:0 0 8px;}\n  .gwa-panel p{font-size:13.5px;line-height:1.45;margin:0 0 15px;}\n  .gwa-av{width:36px;height:36px;}\n  .gwa-who{gap:10px;}\n  .gwa-who strong{font-size:14px;}\n  .gwa-who em{font-size:12px;}\n}\n</style>",
        "background": "",
        "background_gradient": "",
        "text_color": ""
      }
    },
    "custom_liquid_kx7JcM": {
      "type": "custom-liquid",
      "name": "Custom Liquid",
      "settings": {
        "full_width": true,
        "remove_vertical_spacing": false,
        "remove_horizontal_spacing": false,
        "liquid": "{%- comment -%} ══════ RÉGLAGES ══════ {%- endcomment -%}\n{%- assign gwp_handle = 't-shirt-350-grammes' -%}\n{%- assign gwp_freeship = 5000 -%}{%- comment -%} seuil livraison offerte, EN CENTIMES : 5000 = 50 € {%- endcomment -%}\n\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Archivo:ital,wght@0,500;0,700;1,900&display=swap\">\n\n{%- assign p = all_products[gwp_handle] -%}\n{%- if p == blank or p.id == nil -%}\n  {%- assign p = collections.all.products.first -%}\n{%- endif -%}\n{%- assign v = p.selected_or_first_available_variant -%}\n\n{%- if p == blank or p.id == nil -%}\n  <div style=\"padding:40px;text-align:center;font-family:sans-serif\">\n    Produit introuvable : vérifie le handle « {{ gwp_handle }} » en haut du bloc.\n  </div>\n{%- else -%}\n\n<div class=\"gwp\" data-freeship=\"{{ gwp_freeship }}\">\n  <div class=\"gwp-grid\">\n\n    <!-- ══════ GALERIE ══════ -->\n    <div class=\"gwp-media\">\n      <div class=\"gwp-main\">\n        <img id=\"gwpMain\"\n             src=\"{{ v.featured_image | default: p.featured_image | image_url: width: 1200 }}\"\n             alt=\"{{ p.title | escape }}\" width=\"1200\" height=\"1500\">\n      </div>\n\n      {%- if p.images.size > 1 -%}\n      <div class=\"gwp-thumbs\">\n        {%- for img in p.images limit: 6 -%}\n          <button type=\"button\" class=\"gwp-thumb{% if forloop.first %} is-on{% endif %}\"\n                  data-full=\"{{ img | image_url: width: 1200 }}\" aria-label=\"Voir l'image {{ forloop.index }}\">\n            <img src=\"{{ img | image_url: width: 240 }}\" alt=\"\" loading=\"lazy\" width=\"240\" height=\"300\">\n          </button>\n        {%- endfor -%}\n      </div>\n      {%- endif -%}\n    </div>\n\n    <!-- ══════ INFOS ══════ -->\n    <div class=\"gwp-info\">\n      <p class=\"gwp-kicker\">Le t-shirt Grignywood</p>\n      <h1 class=\"gwp-title\">{{ p.title }}</h1>\n\n      <div class=\"gwp-price\">\n        <span id=\"gwpPrice\">{{ v.price | money }}</span>\n        {%- if v.compare_at_price > v.price -%}\n          <s id=\"gwpWas\">{{ v.compare_at_price | money }}</s>\n        {%- endif -%}\n      </div>\n\n      <p class=\"gwp-pitch\">100 % coton naturel, 350 g/m². Coupe oversize. Les bénéfices financent les projets de l'association.</p>\n\n      {%- form 'product', p, id: 'gwpForm', class: 'gwp-form' -%}\n        <input type=\"hidden\" name=\"id\" id=\"gwpVariantId\" value=\"{{ v.id }}\">\n\n        {%- for option in p.options_with_values -%}\n          {%- assign is_color = false -%}\n          {%- assign oname = option.name | downcase -%}\n          {%- if oname contains 'couleur' or oname contains 'color' -%}{%- assign is_color = true -%}{%- endif -%}\n\n          <div class=\"gwp-opt\" data-opt-index=\"{{ forloop.index }}\">\n            <div class=\"gwp-opt-head\">\n              <span class=\"gwp-opt-name\">{{ option.name }}</span>\n              <span class=\"gwp-opt-val\" id=\"gwpOptVal{{ forloop.index }}\">{{ option.selected_value }}</span>\n            </div>\n\n            <div class=\"gwp-choices{% if is_color %} is-color{% endif %}\">\n              {%- for value in option.values -%}\n                {%- assign vlow = value | downcase -%}\n                {%- assign swatch = '#CCCCCC' -%}\n                {%- if vlow contains 'noir' or vlow contains 'black' -%}{%- assign swatch = '#111111' -%}{%- endif -%}\n                {%- if vlow contains 'blanc' or vlow contains 'white' or vlow contains 'beige' -%}{%- assign swatch = '#FFFFFF' -%}{%- endif -%}\n\n                <button type=\"button\"\n                        class=\"gwp-choice{% if value == option.selected_value %} is-on{% endif %}\"\n                        data-opt=\"{{ forloop.parentloop.index }}\"\n                        data-value=\"{{ value | escape }}\"\n                        {% if is_color %}style=\"--sw:{{ swatch }}\"{% endif %}\n                        aria-label=\"{{ option.name }} {{ value | escape }}\">\n                  {%- if is_color -%}<span class=\"gwp-sw\" aria-hidden=\"true\"></span>{%- endif -%}\n                  <span class=\"gwp-choice-label\">{{ value }}</span>\n                </button>\n              {%- endfor -%}\n            </div>\n          </div>\n        {%- endfor -%}\n\n        <details class=\"gwp-guide\">\n          <summary>Guide des tailles</summary>\n          <div class=\"gwp-guide-body\">\n            <table>\n              <thead><tr><th>Taille</th><th>Largeur poitrine</th><th>Longueur</th></tr></thead>\n              <tbody>\n                <tr><td>S</td><td>▮▮ cm</td><td>▮▮ cm</td></tr>\n                <tr><td>M</td><td>▮▮ cm</td><td>▮▮ cm</td></tr>\n                <tr><td>L</td><td>▮▮ cm</td><td>▮▮ cm</td></tr>\n                <tr><td>XL</td><td>▮▮ cm</td><td>▮▮ cm</td></tr>\n                <tr><td>2XL</td><td>▮▮ cm</td><td>▮▮ cm</td></tr>\n              </tbody>\n            </table>\n            <p>La coupe est oversize. Pour un porté plus ajusté, descends d'une taille.</p>\n          </div>\n        </details>\n\n        <div class=\"gwp-qty\">\n          <span class=\"gwp-opt-name\">Quantité</span>\n          <div class=\"gwp-qty-box\">\n            <button type=\"button\" id=\"gwpMinus\" aria-label=\"Retirer un article\">−</button>\n            <input type=\"number\" name=\"quantity\" id=\"gwpQty\" value=\"1\" min=\"1\" inputmode=\"numeric\">\n            <button type=\"button\" id=\"gwpPlus\" aria-label=\"Ajouter un article\">+</button>\n          </div>\n        </div>\n\n        <!-- ══════ LIVRAISON OFFERTE ══════ -->\n        <div class=\"gwp-ship\" id=\"gwpShip\" hidden>\n          <p class=\"gwp-ship-msg\" id=\"gwpShipMsg\"></p>\n          <div class=\"gwp-ship-bar\"><span id=\"gwpShipFill\"></span></div>\n          <p class=\"gwp-ship-sub\" id=\"gwpShipSub\"></p>\n        </div>\n\n        <button type=\"submit\" class=\"gwp-add\" id=\"gwpAdd\" {% unless v.available %}disabled{% endunless %}>\n          <span id=\"gwpAddLabel\">{% if v.available %}Ajouter au panier{% else %}Rupture de stock{% endif %}</span>\n        </button>\n\n        <div class=\"gwp-pay\">{{ form | payment_button }}</div>\n      {%- endform -%}\n\n      <ul class=\"gwp-trust\">\n        <li>\n          <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 20s-7-4.5-7-9a4 4 0 0 1 7-2.6A4 4 0 0 1 19 11c0 4.5-7 9-7 9z\"/></svg>\n          <span>Les bénéfices financent nos projets</span>\n        </li>\n        <li>\n          <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 7h16v13H4z\"/><path d=\"M8 7V4h8v3\"/></svg>\n          <span>Coton lourd 350 g, coupe oversize</span>\n        </li>\n        <li>\n          <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"10\" r=\"3\"/><path d=\"M12 21s7-6.2 7-11a7 7 0 1 0-14 0c0 4.8 7 11 7 11z\"/></svg>\n          <span>Retrait en main propre possible en Essonne</span>\n        </li>\n      </ul>\n    </div>\n\n  </div>\n</div>\n\n<script type=\"application/json\" id=\"gwpVariants\">{{ p.variants | json }}</script>\n\n<script>\n(function(){\n  var root   = document.querySelector('.gwp');\n  var form   = document.getElementById('gwpForm');\n  if(!root || !form) return;\n\n  var THRESHOLD = parseInt(root.getAttribute('data-freeship'), 10) || 0;\n  var vars   = JSON.parse(document.getElementById('gwpVariants').textContent || '[]');\n  var idIn   = document.getElementById('gwpVariantId');\n  var priceEl= document.getElementById('gwpPrice');\n  var wasEl  = document.getElementById('gwpWas');\n  var addBtn = document.getElementById('gwpAdd');\n  var addLab = document.getElementById('gwpAddLabel');\n  var mainImg= document.getElementById('gwpMain');\n  var qtyIn  = document.getElementById('gwpQty');\n\n  var shipBox = document.getElementById('gwpShip');\n  var shipMsg = document.getElementById('gwpShipMsg');\n  var shipFill= document.getElementById('gwpShipFill');\n  var shipSub = document.getElementById('gwpShipSub');\n  var cartTotal = 0;\n\n  function money(cents){\n    return (cents/100).toLocaleString('fr-FR',{minimumFractionDigits:2,maximumFractionDigits:2}) + ' €';\n  }\n\n  function selected(){\n    var out = [];\n    form.querySelectorAll('.gwp-opt').forEach(function(block){\n      var on = block.querySelector('.gwp-choice.is-on');\n      out.push(on ? on.getAttribute('data-value') : null);\n    });\n    return out;\n  }\n\n  function match(sel){\n    return vars.find(function(vr){\n      return sel.every(function(val, i){ return vr['option'+(i+1)] === val; });\n    });\n  }\n\n  function currentVariant(){ return match(selected()); }\n\n  function refreshShipping(){\n    if(!THRESHOLD){ shipBox.hidden = true; return; }\n    shipBox.hidden = false;\n\n    var vr  = currentVariant();\n    var qty = parseInt(qtyIn.value, 10) || 1;\n    var add = vr ? vr.price * qty : 0;\n\n    if(cartTotal >= THRESHOLD){\n      shipMsg.textContent = 'Livraison offerte — c\\u2019est acquis';\n      shipFill.style.width = '100%';\n      shipBox.classList.add('is-done');\n      shipSub.textContent = '';\n      return;\n    }\n\n    var left = THRESHOLD - cartTotal;\n    shipBox.classList.remove('is-done');\n    shipMsg.textContent = 'Plus que ' + money(left) + ' pour la livraison offerte';\n    shipFill.style.width = Math.min(100, (cartTotal / THRESHOLD) * 100) + '%';\n\n    if(add > 0){\n      var after = cartTotal + add;\n      shipSub.textContent = after >= THRESHOLD\n        ? 'Avec cet article, la livraison passe offerte.'\n        : 'Avec cet article, il restera ' + money(THRESHOLD - after) + '.';\n    } else {\n      shipSub.textContent = '';\n    }\n  }\n\n  function refresh(){\n    var sel = selected();\n    var vr  = match(sel);\n\n    form.querySelectorAll('.gwp-opt').forEach(function(block, i){\n      var lab = document.getElementById('gwpOptVal' + (i+1));\n      if(lab) lab.textContent = sel[i] || '';\n    });\n\n    /* grise les combinaisons indisponibles */\n    form.querySelectorAll('.gwp-choice').forEach(function(btn){\n      var i    = parseInt(btn.getAttribute('data-opt'),10) - 1;\n      var test = sel.slice();\n      test[i]  = btn.getAttribute('data-value');\n      var cand = match(test);\n      btn.classList.toggle('is-off', !(cand && cand.available));\n    });\n\n    if(!vr){\n      addBtn.disabled = true;\n      addLab.textContent = 'Indisponible';\n      refreshShipping();\n      return;\n    }\n\n    idIn.value = vr.id;\n    priceEl.textContent = money(vr.price);\n    if(wasEl){\n      if(vr.compare_at_price && vr.compare_at_price > vr.price){\n        wasEl.textContent = money(vr.compare_at_price);\n        wasEl.style.display = '';\n      } else { wasEl.style.display = 'none'; }\n    }\n    addBtn.disabled = !vr.available;\n    addLab.textContent = vr.available ? 'Ajouter au panier' : 'Rupture de stock';\n\n    if(vr.featured_image && vr.featured_image.src && mainImg){\n      mainImg.src = vr.featured_image.src;\n    }\n\n    refreshShipping();\n  }\n\n  form.querySelectorAll('.gwp-choice').forEach(function(btn){\n    btn.addEventListener('click', function(){\n      var i = btn.getAttribute('data-opt');\n      form.querySelectorAll('.gwp-choice[data-opt=\"'+i+'\"]').forEach(function(b){ b.classList.remove('is-on'); });\n      btn.classList.add('is-on');\n      refresh();\n    });\n  });\n\n  document.getElementById('gwpMinus').addEventListener('click', function(){\n    qtyIn.value = Math.max(1, (parseInt(qtyIn.value,10)||1) - 1);\n    refreshShipping();\n  });\n  document.getElementById('gwpPlus').addEventListener('click', function(){\n    qtyIn.value = (parseInt(qtyIn.value,10)||1) + 1;\n    refreshShipping();\n  });\n  qtyIn.addEventListener('change', refreshShipping);\n\n  document.querySelectorAll('.gwp-thumb').forEach(function(t){\n    t.addEventListener('click', function(){\n      document.querySelectorAll('.gwp-thumb').forEach(function(x){ x.classList.remove('is-on'); });\n      t.classList.add('is-on');\n      if(mainImg) mainImg.src = t.getAttribute('data-full');\n    });\n  });\n\n  /* état du panier */\n  fetch('/cart.js', { headers: { 'Accept': 'application/json' } })\n    .then(function(r){ return r.json(); })\n    .then(function(c){ cartTotal = c.total_price || 0; refreshShipping(); })\n    .catch(function(){ refreshShipping(); });\n\n  refresh();\n})();\n</script>\n\n<style>\n.gwp{\n  /* ================= RÉGLAGES ================= */\n  --gw-bg:#FFFFFF;\n  --gw-ink:#111111;\n  --gw-muted:#5A5A5A;\n\n  --gw-frame:#111111;\n  --gw-frame-w:1.5px;\n  --gw-radius:14px;\n  --gw-neon:#F7A81B;\n  --gw-neon-rgb:247,168,27;\n  --gw-halo-0:.45;\n  --gw-halo-1:.50;\n  --gw-halo-2:.32;\n  --gw-halo-3:.18;\n\n  --gw-max:1280px;\n  --gw-media-col:52%;      /* largeur de la colonne image en desktop */\n  /* ============================================ */\n\n  background:var(--gw-bg);\n  color:var(--gw-ink);\n  padding:52px 24px 64px;\n  box-sizing:border-box;\n  font-family:'Archivo',system-ui,sans-serif;\n}\n.gwp *{box-sizing:border-box;}\n\n.gwp-grid{\n  max-width:var(--gw-max);\n  margin:0 auto;\n  display:grid;\n  grid-template-columns:1fr;\n  gap:34px;\n  align-items:start;\n}\n\n/* ---------- GALERIE ---------- */\n.gwp-main{\n  border:var(--gw-frame-w) solid var(--gw-frame);\n  border-radius:var(--gw-radius);\n  overflow:hidden;\n  line-height:0;\n  background:#F4F4F2;\n  box-shadow:\n    0 0 0 1px rgba(var(--gw-neon-rgb),var(--gw-halo-0)),\n    0 0 12px rgba(var(--gw-neon-rgb),var(--gw-halo-1)),\n    0 0 32px rgba(var(--gw-neon-rgb),var(--gw-halo-2)),\n    0 0 62px rgba(var(--gw-neon-rgb),var(--gw-halo-3));\n}\n.gwp-main img{width:100%;height:auto;display:block;}\n\n.gwp-thumbs{\n  display:flex;gap:12px;margin-top:16px;\n  overflow-x:auto;scrollbar-width:none;padding:4px 2px 6px;\n}\n.gwp-thumbs::-webkit-scrollbar{display:none;}\n.gwp-thumb{\n  flex:0 0 auto;width:74px;padding:0;cursor:pointer;\n  border:var(--gw-frame-w) solid rgba(17,17,17,.25);\n  border-radius:10px;overflow:hidden;background:#F4F4F2;line-height:0;\n  transition:border-color .2s ease, box-shadow .2s ease;\n}\n.gwp-thumb img{width:100%;height:auto;display:block;}\n.gwp-thumb.is-on{\n  border-color:var(--gw-frame);\n  box-shadow:0 0 0 1px rgba(var(--gw-neon-rgb),.5), 0 0 10px rgba(var(--gw-neon-rgb),.45);\n}\n\n/* ---------- INFOS ---------- */\n.gwp-kicker{\n  margin:0 0 12px;\n  font-weight:900;font-style:italic;text-transform:uppercase;\n  font-size:clamp(12px,1.05vw,14px);letter-spacing:.04em;\n  color:var(--gw-ink);\n}\n.gwp-title{\n  margin:0 0 14px;\n  font-weight:900;font-style:italic;text-transform:uppercase;\n  font-size:clamp(24px,3.2vw,38px);\n  line-height:1.03;letter-spacing:-0.02em;\n  text-wrap:balance;color:var(--gw-ink);\n}\n.gwp-price{\n  display:flex;align-items:baseline;gap:12px;margin:0 0 18px;\n  font-weight:900;font-style:italic;\n  font-size:clamp(22px,2.4vw,30px);letter-spacing:-0.015em;\n}\n.gwp-price s{\n  font-weight:600;font-style:normal;font-size:.6em;color:var(--gw-muted);\n}\n.gwp-pitch{\n  margin:0 0 28px;\n  font-weight:500;font-style:normal;\n  font-size:clamp(14px,1.1vw,16px);line-height:1.6;\n  color:var(--gw-ink);max-width:52ch;\n}\n\n/* ---------- OPTIONS ---------- */\n.gwp-opt{margin:0 0 22px;}\n.gwp-opt-head{\n  display:flex;align-items:baseline;gap:10px;margin-bottom:10px;\n}\n.gwp-opt-name{\n  font-weight:700;font-style:normal;text-transform:uppercase;\n  font-size:12px;letter-spacing:.09em;color:var(--gw-ink);\n}\n.gwp-opt-val{\n  font-weight:500;font-size:13px;color:var(--gw-muted);\n}\n\n.gwp-choices{display:flex;flex-wrap:wrap;gap:10px;}\n\n.gwp-choice{\n  position:relative;\n  display:inline-flex;align-items:center;gap:9px;\n  min-height:46px;padding:0 18px;cursor:pointer;\n  background:#FFFFFF;\n  border:var(--gw-frame-w) solid rgba(17,17,17,.3);\n  border-radius:999px;\n  font-family:'Archivo',system-ui,sans-serif;\n  font-weight:900;font-style:italic;text-transform:uppercase;\n  font-size:14px;letter-spacing:-0.01em;color:var(--gw-ink);\n  transition:border-color .2s ease, box-shadow .2s ease, opacity .2s ease;\n}\n.gwp-choice:hover{border-color:var(--gw-frame);}\n.gwp-choice.is-on{\n  border-color:var(--gw-frame);\n  box-shadow:\n    0 0 0 1px rgba(var(--gw-neon-rgb),var(--gw-halo-0)),\n    0 0 10px rgba(var(--gw-neon-rgb),var(--gw-halo-1)),\n    0 0 24px rgba(var(--gw-neon-rgb),var(--gw-halo-2));\n}\n.gwp-choice.is-off{\n  opacity:.34;\n  text-decoration:line-through;\n}\n.gwp-sw{\n  width:18px;height:18px;border-radius:50%;\n  background:var(--sw);\n  border:1px solid rgba(17,17,17,.4);\n  flex:0 0 auto;\n}\n\n/* ---------- GUIDE DES TAILLES ---------- */\n.gwp-guide{margin:-6px 0 24px;}\n.gwp-guide summary{\n  cursor:pointer;display:inline-block;\n  font-weight:700;font-size:13px;\n  text-decoration:underline;text-decoration-color:var(--gw-neon);\n  text-decoration-thickness:2px;text-underline-offset:3px;\n}\n.gwp-guide summary::-webkit-details-marker{display:none;}\n.gwp-guide-body{\n  margin-top:14px;padding:16px 18px;\n  border:var(--gw-frame-w) solid var(--gw-frame);\n  border-radius:12px;\n}\n.gwp-guide-body table{width:100%;border-collapse:collapse;font-size:13.5px;}\n.gwp-guide-body th{\n  text-align:left;font-weight:700;text-transform:uppercase;\n  font-size:11px;letter-spacing:.07em;padding:0 0 8px;\n  border-bottom:1px solid rgba(17,17,17,.18);\n}\n.gwp-guide-body td{padding:8px 0;border-bottom:1px solid rgba(17,17,17,.08);font-weight:500;}\n.gwp-guide-body p{margin:12px 0 0;font-size:13px;font-weight:500;color:var(--gw-muted);}\n\n/* ---------- QUANTITÉ ---------- */\n.gwp-qty{display:flex;align-items:center;gap:16px;margin:0 0 22px;}\n.gwp-qty-box{\n  display:inline-flex;align-items:center;\n  border:var(--gw-frame-w) solid var(--gw-frame);\n  border-radius:999px;overflow:hidden;height:46px;\n}\n.gwp-qty-box button{\n  width:42px;height:100%;border:0;background:none;cursor:pointer;\n  font-size:19px;line-height:1;color:var(--gw-ink);\n}\n.gwp-qty-box input{\n  width:46px;height:100%;border:0;text-align:center;\n  font-family:'Archivo',system-ui,sans-serif;\n  font-weight:900;font-style:italic;font-size:15px;color:var(--gw-ink);\n  -moz-appearance:textfield;background:none;\n}\n.gwp-qty-box input::-webkit-outer-spin-button,\n.gwp-qty-box input::-webkit-inner-spin-button{-webkit-appearance:none;margin:0;}\n\n/* ---------- LIVRAISON OFFERTE ---------- */\n.gwp-ship{\n  margin:0 0 20px;padding:15px 17px;\n  border:var(--gw-frame-w) solid var(--gw-frame);\n  border-radius:12px;\n}\n.gwp-ship-msg{\n  margin:0 0 10px;\n  font-weight:900;font-style:italic;text-transform:uppercase;\n  font-size:14px;letter-spacing:-0.01em;color:var(--gw-ink);\n}\n.gwp-ship-bar{\n  height:7px;border-radius:999px;\n  background:rgba(17,17,17,.12);\n  overflow:hidden;\n}\n.gwp-ship-bar span{\n  display:block;height:100%;width:0;\n  background:var(--gw-neon);\n  border-radius:999px;\n  box-shadow:0 0 8px rgba(var(--gw-neon-rgb),.7);\n  transition:width .35s ease;\n}\n.gwp-ship-sub{\n  margin:10px 0 0;\n  font-weight:500;font-size:12.5px;color:var(--gw-muted);\n}\n.gwp-ship.is-done{\n  box-shadow:\n    0 0 0 1px rgba(var(--gw-neon-rgb),var(--gw-halo-0)),\n    0 0 10px rgba(var(--gw-neon-rgb),var(--gw-halo-1));\n}\n\n/* ---------- BOUTONS ---------- */\n.gwp-add{\n  width:100%;min-height:58px;cursor:pointer;\n  background:var(--gw-ink);color:#FFFFFF;\n  border:var(--gw-frame-w) solid var(--gw-frame);\n  border-radius:999px;\n  font-family:'Archivo',system-ui,sans-serif;\n  font-weight:900;font-style:italic;text-transform:uppercase;\n  font-size:17px;letter-spacing:-0.01em;\n  box-shadow:\n    0 0 0 1px rgba(var(--gw-neon-rgb),var(--gw-halo-0)),\n    0 0 12px rgba(var(--gw-neon-rgb),var(--gw-halo-1)),\n    0 0 30px rgba(var(--gw-neon-rgb),var(--gw-halo-2)),\n    0 0 58px rgba(var(--gw-neon-rgb),var(--gw-halo-3));\n  transition:transform .15s ease, opacity .2s ease;\n}\n.gwp-add:hover{transform:translateY(-1px);}\n.gwp-add:disabled{opacity:.45;cursor:not-allowed;box-shadow:none;transform:none;}\n\n.gwp-pay{margin-top:12px;}\n.gwp-pay .shopify-payment-button__button{\n  border-radius:999px !important;\n  min-height:56px !important;\n  font-family:'Archivo',system-ui,sans-serif !important;\n  font-weight:900 !important;\n  font-style:italic !important;\n  text-transform:uppercase !important;\n  font-size:16px !important;\n}\n\n/* ---------- RÉASSURANCE ---------- */\n.gwp-trust{\n  list-style:none;margin:28px 0 0;padding:22px 0 0;\n  border-top:1px solid rgba(17,17,17,.14);\n  display:flex;flex-direction:column;gap:14px;\n}\n.gwp-trust li{display:flex;align-items:center;gap:12px;}\n.gwp-trust svg{\n  flex:0 0 auto;width:22px;height:22px;\n  fill:none;stroke:var(--gw-neon);stroke-width:2;\n  stroke-linecap:round;stroke-linejoin:round;\n  filter:drop-shadow(0 0 4px rgba(var(--gw-neon-rgb),.6));\n}\n.gwp-trust span{\n  font-weight:700;font-style:normal;\n  font-size:14px;line-height:1.35;color:var(--gw-ink);\n}\n\n/* ---------- DESKTOP ---------- */\n@media(min-width:900px){\n  .gwp{padding:64px 24px 76px;}\n  .gwp-grid{\n    grid-template-columns:var(--gw-media-col) 1fr;\n    gap:56px;\n  }\n  .gwp-info{padding-top:6px;}\n}\n\n@media(max-width:899px){\n  .gwp{padding:40px 16px 52px;--gw-radius:12px;}\n  .gwp-choice{min-height:44px;padding:0 15px;font-size:13.5px;}\n  .gwp-add{min-height:54px;font-size:16px;}\n}\n</style>\n\n{%- endif -%}",
        "background": "",
        "background_gradient": "",
        "text_color": ""
      }
    },
    "custom_liquid_AJXF8t": {
      "type": "custom-liquid",
      "name": "Custom Liquid",
      "settings": {
        "full_width": true,
        "remove_vertical_spacing": true,
        "remove_horizontal_spacing": true,
        "liquid": "<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Archivo:ital,wght@0,600;1,900&display=swap\">\n\n<div class=\"gwv\">\n  <h2 class=\"gwv-title\">Ce qu'une photo ne montre pas</h2>\n\n  <div class=\"gwv-grid\">\n\n    <figure class=\"gwv-item\">\n      <video\n        src=\"https://cdn.shopify.com/videos/c/o/v/a83ddc9ffd6341a6a08715efa5144aab.mp4\"\n        autoplay muted loop playsinline preload=\"metadata\"\n        disablepictureinpicture controlslist=\"nodownload noplaybackrate\"></video>\n      <figcaption>Ça se défend</figcaption>\n    </figure>\n\n    <figure class=\"gwv-item\">\n      <video\n        src=\"https://cdn.shopify.com/videos/c/o/v/4e00913e940f492d9b7957cd50616eb6.mp4\"\n        autoplay muted loop playsinline preload=\"metadata\"\n        disablepictureinpicture controlslist=\"nodownload noplaybackrate\"></video>\n      <figcaption>Ça se voit</figcaption>\n    </figure>\n\n    <figure class=\"gwv-item\">\n      <video\n        src=\"https://cdn.shopify.com/videos/c/o/v/d080c7f7dfd74a2894811fe10e1e284e.mp4\"\n        autoplay muted loop playsinline preload=\"metadata\"\n        disablepictureinpicture controlslist=\"nodownload noplaybackrate\"></video>\n      <figcaption>Ça se sent</figcaption>\n    </figure>\n\n  </div>\n</div>\n\n<style>\n.gwv{\n  /* ================= RÉGLAGES ================= */\n  --gw-bg:#FFFFFF;\n  --gw-ink:#111111;\n\n  /* ---- CADRE + NÉON — identiques aux autres sections ---- */\n  --gw-frame:#111111;\n  --gw-frame-w:1.5px;\n  --gw-radius:14px;\n  --gw-neon:#F7A81B;\n  --gw-neon-rgb:247,168,27;\n  --gw-halo-0:.45;\n  --gw-halo-1:.50;\n  --gw-halo-2:.32;\n  --gw-halo-3:.18;\n\n  --gw-max:1100px;          /* largeur totale des trois vidéos */\n  --gw-gap:26px;            /* écart entre les vidéos */\n  --gw-ratio:9 / 16;        /* format des vidéos */\n  --gw-card-w:74vw;         /* largeur d'une vidéo en défilement mobile */\n  /* ============================================ */\n\n  background:var(--gw-bg);\n  color:var(--gw-ink);\n  padding:58px 24px 66px;\n  box-sizing:border-box;\n  font-family:'Archivo',system-ui,sans-serif;\n}\n.gwv *{box-sizing:border-box;}\n\n/* GRAND TITRE DE SECTION — standard commun à tout le site. */\n.gwv-title{\n  font-family:'Archivo',system-ui,sans-serif;\n  font-weight:900;font-style:italic;text-transform:uppercase;\n  text-align:center;color:var(--gw-ink);\n  font-size:clamp(22px,3.4vw,38px);\n  line-height:1.05;letter-spacing:-0.015em;\n  text-wrap:balance;\n  margin:0 0 40px;\n}\n\n.gwv-grid{\n  display:grid;\n  grid-template-columns:repeat(3,1fr);\n  gap:var(--gw-gap);\n  max-width:var(--gw-max);\n  margin:0 auto;\n}\n\n.gwv-item{\n  margin:0;\n  display:flex;\n  flex-direction:column;\n  min-width:0;\n}\n\n.gwv-item video{\n  display:block;\n  width:100%;\n  aspect-ratio:var(--gw-ratio);\n  object-fit:cover;\n  background:#EEEEEE;\n  border:var(--gw-frame-w) solid var(--gw-frame);\n  border-radius:var(--gw-radius);\n  box-shadow:\n    0 0 0 1px rgba(var(--gw-neon-rgb),var(--gw-halo-0)),\n    0 0 10px rgba(var(--gw-neon-rgb),var(--gw-halo-1)),\n    0 0 26px rgba(var(--gw-neon-rgb),var(--gw-halo-2)),\n    0 0 52px rgba(var(--gw-neon-rgb),var(--gw-halo-3));\n}\n\n.gwv-item figcaption{\n  margin-top:16px;\n  text-align:center;\n  font-family:'Archivo',system-ui,sans-serif;\n  font-weight:900;font-style:italic;text-transform:uppercase;\n  font-size:clamp(14px,1.3vw,18px);\n  line-height:1.15;letter-spacing:-0.015em;\n  color:var(--gw-ink);\n}\n\n/* --- MOBILE : défilement latéral --- */\n@media(max-width:749px){\n  .gwv{\n    padding:42px 0 48px;\n    width:100vw;max-width:100vw;\n    margin-left:calc(50% - 50vw);\n    margin-right:calc(50% - 50vw);\n    --gw-radius:12px;\n  }\n  .gwv-title{margin:0 20px 26px;}\n\n  .gwv-grid{\n    display:flex;\n    flex-direction:row;\n    gap:18px;\n    max-width:none;\n    padding:6px 16px 12px;       /* marge pour que le halo ne soit pas coupé */\n    overflow-x:auto;\n    overflow-y:hidden;\n    scroll-snap-type:x mandatory;\n    -webkit-overflow-scrolling:touch;\n    scrollbar-width:none;\n  }\n  .gwv-grid::-webkit-scrollbar{display:none;}\n\n  .gwv-item{\n    flex:0 0 var(--gw-card-w);\n    scroll-snap-align:center;\n  }\n  .gwv-item figcaption{margin-top:12px;font-size:15px;}\n}\n\n@media(prefers-reduced-motion:reduce){\n  .gwv-item video{animation:none;}\n}\n</style>\n\n<script>\n(function(){\n  var vids = document.querySelectorAll('.gwv-item video');\n  if(!vids.length) return;\n\n  /* Relance la lecture si le navigateur l'a bloquée au chargement */\n  vids.forEach(function(v){\n    v.muted = true;\n    var p = v.play();\n    if(p && p.catch){ p.catch(function(){}); }\n  });\n\n  /* Économie de ressources : on ne lit que ce qui est à l'écran */\n  if(!('IntersectionObserver' in window)) return;\n  var io = new IntersectionObserver(function(entries){\n    entries.forEach(function(e){\n      if(e.isIntersecting){\n        var p = e.target.play();\n        if(p && p.catch){ p.catch(function(){}); }\n      } else {\n        e.target.pause();\n      }\n    });\n  }, { threshold: 0.2 });\n\n  vids.forEach(function(v){ io.observe(v); });\n})();\n</script>",
