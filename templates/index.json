        "liquid": "<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Archivo:ital,wght@1,900&display=swap\">\n\n<div class=\"gwb\">\n  <h2 class=\"gwb-title\">Pourquoi tu vas kiffer ton Grignywood</h2>\n\n  <div class=\"gwb-grid\">\n\n    <!-- ===== 1 · HAUT GAUCHE — motif d'achat n°1 (53 %) ===== -->\n    <div class=\"gwb-card gwb-b1\">\n      <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 20s-7-4.5-7-9a4 4 0 0 1 7-2.6A4 4 0 0 1 19 11c0 4.5-7 9-7 9z\"/></svg>\n      <span>Ton argent sert enfin à quelque chose</span>\n    </div>\n\n    <!-- ===== 2 · HAUT DROITE — identité / appartenance (56 %) ===== -->\n    <div class=\"gwb-card gwb-b2\">\n      <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M3 21V11l4-3v13M11 21V7l5-4v18M19 21v-8l2 1.6V21\"/><path d=\"M2 21h20\"/></svg>\n      <span>Tu représentes les tiens</span>\n    </div>\n\n    <!-- ===== 3 · MILIEU GAUCHE — appartenance ===== -->\n    <div class=\"gwb-card gwb-b3\">\n      <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><circle cx=\"8.5\" cy=\"9\" r=\"3\"/><circle cx=\"16\" cy=\"9.5\" r=\"2.4\"/><path d=\"M3 20c0-3.3 2.5-5.5 5.5-5.5S14 16.7 14 20\"/><path d=\"M14.5 20c0-2.6 1.8-4.4 4-4.4 1.4 0 2.5.6 3.2 1.6\"/></svg>\n      <span>Tu entres dans une famille</span>\n    </div>\n\n    <!-- ===== L'IMAGE ===== -->\n    <figure class=\"gwb-media\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0980/1724/7556/files/ChatGPT_Image_13_sept._2026_17_19_32.png?v=1789313291\"\n           alt=\"T-shirt Grignywood oversize noir, coton lourd 350 g\" loading=\"lazy\">\n    </figure>\n\n    <!-- ===== 4 · MILIEU DROITE — valeurs / histoire (44 %) ===== -->\n    <div class=\"gwb-card gwb-b4\">\n      <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M2 5c4-2 7-2 10 0 3-2 6-2 10 0v14c-4-2-7-2-10 0-3-2-6-2-10 0V5z\"/><path d=\"M12 5v14\"/></svg>\n      <span>Tu portes une histoire vraie</span>\n    </div>\n\n    <!-- ===== 5 · BAS GAUCHE — logo assumé (47 %) ===== -->\n    <div class=\"gwb-card gwb-b5\">\n      <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M1.8 12S5.5 5.5 12 5.5 22.2 12 22.2 12 18.5 18.5 12 18.5 1.8 12 1.8 12z\"/><circle cx=\"12\" cy=\"12\" r=\"3.2\"/></svg>\n      <span>On le reconnaît de loin</span>\n    </div>\n\n    <!-- ===== 6 · BAS DROITE — lève l'objection légitimité ===== -->\n    <div class=\"gwb-card gwb-b6\">\n      <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M3 12h18\"/><path d=\"M12 3c2.6 2.8 4 5.8 4 9s-1.4 6.2-4 9c-2.6-2.8-4-5.8-4-9s1.4-6.2 4-9z\"/></svg>\n      <span>Pas besoin d'être de Grigny</span>\n    </div>\n\n  </div>\n</div>\n\n<style>\n.gwb{\n  /* ================= RÉGLAGES ================= */\n  --gw-bg:#FFFFFF;\n  --gw-ink:#111111;\n\n  /* ---- CADRE ---- */\n  --gw-frame:#111111;        /* couleur du cadre : noir */\n  --gw-frame-w:1.5px;        /* épaisseur du cadre */\n\n  /* ---- NÉON ---- */\n  --gw-neon:#F7A81B;         /* orange doux — couleur des icônes */\n  --gw-neon-rgb:247,168,27;  /* le même en RGB, pour les halos */\n  --gw-halo-0:.45;           /* liseré collé au cadre */\n  --gw-halo-1:.50;           /* halo proche, 10 px */\n  --gw-halo-2:.32;           /* halo moyen, 26 px */\n  --gw-halo-3:.18;           /* halo large, 52 px */\n\n  --gw-card-bg:#FFFFFF;\n  --gw-card-min:82px;        /* hauteur des cartes en desktop — elles ne s'étirent plus */\n  --gw-grid-max:1320px;\n  --gw-img-max:460px;\n  /* ============================================ */\n\n  background:var(--gw-bg);\n  color:var(--gw-ink);\n  padding:60px 24px 68px;\n  box-sizing:border-box;\n}\n.gwb *{box-sizing:border-box;}\n\n/* GRAND TITRE DE SECTION — standard commun à tout le site. */\n.gwb-title{\n  font-family:'Archivo',system-ui,sans-serif;\n  font-weight:900;font-style:italic;text-transform:uppercase;\n  text-align:center;color:var(--gw-ink);\n  font-size:clamp(22px,3.4vw,38px);\n  line-height:1.05;letter-spacing:-0.015em;\n  text-wrap:balance;\n  margin:0 0 44px;\n}\n\n.gwb-grid{\n  display:grid;\n  grid-template-columns:1fr;\n  gap:16px;\n  max-width:var(--gw-grid-max);\n  margin:0 auto;\n  align-items:stretch;\n}\n\n/* ---------- ENCADRÉS : CADRE NOIR FIN + NÉON ORANGE ---------- */\n.gwb-card{\n  display:flex;\n  align-items:center;\n  gap:14px;\n  background:var(--gw-card-bg);\n  border:var(--gw-frame-w) solid var(--gw-frame);\n  border-radius:14px;\n  padding:16px 18px;\n  box-shadow:\n    0 0 0 1px rgba(var(--gw-neon-rgb),var(--gw-halo-0)),\n    0 0 10px rgba(var(--gw-neon-rgb),var(--gw-halo-1)),\n    0 0 26px rgba(var(--gw-neon-rgb),var(--gw-halo-2)),\n    0 0 52px rgba(var(--gw-neon-rgb),var(--gw-halo-3));\n}\n.gwb-card span{\n  flex:1;\n  min-width:0;\n  align-self:center;\n  text-wrap:pretty;\n  hyphens:none;\n  font-family:'Archivo',system-ui,sans-serif;\n  font-weight:900;font-style:italic;text-transform:uppercase;\n  font-size:15px;line-height:1.2;letter-spacing:-0.02em;\n  color:var(--gw-ink);\n}\n.gwb-card svg{\n  flex:0 0 auto;width:24px;height:24px;\n  align-self:center;\n  fill:none;stroke:var(--gw-neon);stroke-width:2;\n  stroke-linecap:round;stroke-linejoin:round;\n  filter:drop-shadow(0 0 4px rgba(var(--gw-neon-rgb),.65));\n}\n\n/* ---------- IMAGE ---------- */\n.gwb-media{\n  margin:8px auto;\n  padding:14px;\n  background:var(--gw-card-bg);\n  border:var(--gw-frame-w) solid var(--gw-frame);\n  border-radius:18px;\n  max-width:var(--gw-img-max);\n  width:100%;\n  box-shadow:\n    0 0 0 1px rgba(var(--gw-neon-rgb),var(--gw-halo-0)),\n    0 0 12px rgba(var(--gw-neon-rgb),var(--gw-halo-1)),\n    0 0 32px rgba(var(--gw-neon-rgb),var(--gw-halo-2)),\n    0 0 62px rgba(var(--gw-neon-rgb),var(--gw-halo-3));\n}\n.gwb-media img{display:block;width:100%;height:auto;border-radius:8px;}\n\n/* ---------- MOBILE : cartes compactes, texte qui remplit la largeur ---------- */\n@media(max-width:899px){\n  .gwb{padding:40px 16px 46px;}\n  .gwb-title{margin:0 0 26px;}\n  .gwb-grid{gap:12px;}\n\n  .gwb-card{\n    padding:13px 16px;\n    gap:12px;\n    border-radius:12px;\n  }\n  .gwb-card span{font-size:14.5px;line-height:1.18;}\n  .gwb-card svg{width:22px;height:22px;}\n\n  .gwb-media{margin:4px auto;padding:10px;border-radius:14px;}\n}\n\n/* ---------- DESKTOP : 3 à gauche · image · 3 à droite ---------- */\n@media(min-width:900px){\n  .gwb-grid{\n    grid-template-columns:1fr minmax(280px,var(--gw-img-max)) 1fr;\n    grid-template-rows:repeat(3,1fr);\n    gap:20px 40px;\n    align-items:center;              /* les cartes se centrent dans leur rangée */\n  }\n  .gwb-b1{grid-column:1;grid-row:1;}\n  .gwb-b3{grid-column:1;grid-row:2;}\n  .gwb-b5{grid-column:1;grid-row:3;}\n\n  .gwb-media{grid-column:2;grid-row:1 / span 3;margin:0;align-self:stretch;\n             display:flex;align-items:center;}\n\n  .gwb-b2{grid-column:3;grid-row:1;}\n  .gwb-b4{grid-column:3;grid-row:2;}\n  .gwb-b6{grid-column:3;grid-row:3;}\n\n  /* la carte prend la hauteur de son contenu, pas celle de la rangée */\n  .gwb-card{\n    height:auto;\n    min-height:var(--gw-card-min);\n    align-self:center;\n    padding:16px 22px;\n    gap:16px;\n  }\n  .gwb-card span{font-size:17px;line-height:1.22;text-wrap:balance;}\n  .gwb-card svg{width:28px;height:28px;}\n\n  /* colonne de gauche : icône à droite, texte aligné à droite */\n  .gwb-b1,.gwb-b3,.gwb-b5{flex-direction:row-reverse;}\n  .gwb-b1 span,.gwb-b3 span,.gwb-b5 span{text-align:right;}\n\n  .gwb-b2 span,.gwb-b4 span,.gwb-b6 span{text-align:left;}\n}",
