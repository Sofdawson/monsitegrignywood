    </div>\n\n    <div class=\"gwb-card gwb-b6\">\n      <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"8\" r=\"3.2\"/><path d=\"M5 21c0-4 3.1-6.5 7-6.5s7 2.5 7 6.5\"/></svg>\n      <span>Tu te ressembles enfin</span>\n    </div>\n\n  </div>\n</div>\n\n<style>\n@import url('https://fonts.googleapis.com/css2?family=Archivo:ital,wght@1,900&display=swap');\n\n.gwb{\n  /* ================= RÉGLAGES ================= */\n  --gw-bg:#FFFFFF;\n  --gw-ink:#111111;\n  --gw-neon:#F5C518;         /* même orange que le bandeau presse et le module 3 lignes */\n  --gw-neon-rgb:245,197,24;  /* le même en RGB, pour les halos */\n  --gw-card-bg:#FFFFFF;\n  --gw-grid-max:1440px;\n  --gw-img-max:500px;\n  /* ============================================ */\n\n  background:var(--gw-bg);\n  color:var(--gw-ink);\n  padding:60px 24px 68px;\n  box-sizing:border-box;\n}\n\n/* GRAND TITRE DE SECTION — standard commun à tout le site. */\n.gwb-title{\n  font-family:'Archivo',system-ui,sans-serif;\n  font-weight:900;font-style:italic;text-transform:uppercase;\n  text-align:center;color:var(--gw-ink);\n  font-size:clamp(22px,3.4vw,38px);\n  line-height:1.05;letter-spacing:-0.015em;\n  margin:0 0 44px;\n}\n\n.gwb-grid{\n  display:grid;\n  grid-template-columns:1fr;\n  gap:16px;\n  max-width:var(--gw-grid-max);\n  margin:0 auto;\n  align-items:center;\n}\n\n/* ---------- ENCADRÉS NÉON ---------- */\n.gwb-card{\n  display:flex;align-items:center;gap:16px;\n  background:var(--gw-card-bg);\n  border:2.5px solid var(--gw-neon);\n  border-radius:14px;\n  padding:16px 20px;\n  box-sizing:border-box;\n  box-shadow:\n    0 0 0 1px rgba(var(--gw-neon-rgb),.95),\n    0 0 9px rgba(var(--gw-neon-rgb),.95),\n    0 0 24px rgba(var(--gw-neon-rgb),.62),\n    0 0 44px rgba(var(--gw-neon-rgb),.34),\n    inset 0 0 14px rgba(var(--gw-neon-rgb),.30);\n}\n.gwb-card span{\n  flex:1;\n  text-wrap:normal;\n  font-family:'Archivo',system-ui,sans-serif;\n  font-weight:900;font-style:italic;text-transform:uppercase;\n  font-size:15px;line-height:1.25;letter-spacing:-0.02em;\n  color:var(--gw-ink);\n}\n.gwb-card svg{\n  flex:0 0 auto;width:26px;height:26px;\n  fill:none;stroke:var(--gw-neon);stroke-width:2;\n  stroke-linecap:round;stroke-linejoin:round;\n  filter:drop-shadow(0 0 3px rgba(var(--gw-neon-rgb),1))\n         drop-shadow(0 0 9px rgba(var(--gw-neon-rgb),.7));\n}\n\n/* ---------- IMAGE ---------- */\n.gwb-media{\n  margin:8px auto;\n  padding:16px;\n  background:var(--gw-card-bg);\n  border:2.5px solid var(--gw-neon);\n  border-radius:18px;\n  box-sizing:border-box;\n  max-width:var(--gw-img-max);\n  width:100%;\n  box-shadow:\n    0 0 0 1px rgba(var(--gw-neon-rgb),.95),\n    0 0 12px rgba(var(--gw-neon-rgb),.95),\n    0 0 34px rgba(var(--gw-neon-rgb),.66),\n    0 0 64px rgba(var(--gw-neon-rgb),.36),\n    inset 0 0 20px rgba(var(--gw-neon-rgb),.24);\n}\n.gwb-media img{display:block;width:100%;height:auto;border-radius:8px;}\n\n/* ---------- DESKTOP : 3 à gauche · image · 3 à droite ---------- */\n@media(min-width:900px){\n  .gwb-grid{\n    grid-template-columns:1fr minmax(300px,var(--gw-img-max)) 1fr;\n    grid-template-rows:repeat(3,auto);\n    gap:26px 46px;\n  }\n  .gwb-b1{grid-column:1;grid-row:1;}\n  .gwb-b3{grid-column:1;grid-row:2;}\n  .gwb-b5{grid-column:1;grid-row:3;}\n\n  .gwb-media{grid-column:2;grid-row:1 / span 3;margin:0;}\n\n  .gwb-b2{grid-column:3;grid-row:1;}\n  .gwb-b4{grid-column:3;grid-row:2;}\n  .gwb-b6{grid-column:3;grid-row:3;}\n\n  .gwb-card{padding:22px 24px;min-height:110px;gap:16px;}\n  .gwb-card span{font-size:17px;}\n  .gwb-card svg{width:30px;height:30px;}\n\n  .gwb-b1,.gwb-b3,.gwb-b5{flex-direction:row-reverse;}\n  .gwb-b1 span,.gwb-b3 span,.gwb-b5 span{text-align:right;}\n\n  .gwb-b2 span,.gwb-b4 span,.gwb-b6 span{text-align:left;}\n}\n</style>",
