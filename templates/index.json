    "custom_liquid_kx7JcM": {
      "type": "custom-liquid",
      "name": "Custom Liquid",
      "settings": {
        "full_width": true,
        "remove_vertical_spacing": true,
        "remove_horizontal_spacing": true,
        "liquid": "{%- comment -%} ===== GRIGNYWOOD — FICHE PRODUIT ===== {%- endcomment -%}\n\n{%- assign gwp_handle    = 't-shirt-350-grammes' -%}\n{%- assign gwp_freeship  = 5000 -%}{%- comment -%} 50,00 € EN CENTIMES {%- endcomment -%}\n\n{%- comment -%} --- CHIFFRES RÉELS (étude sept. 2026) --- {%- endcomment -%}\n{%- assign gwp_clients   = 396 -%}\n{%- assign gwp_commandes = 451 -%}\n{%- assign gwp_fideles   = 44 -%}\n{%- assign gwp_partfid   = 22 -%}\n{%- assign gwp_abonnes   = 5508 -%}\n\n{%- comment -%}\n  --- 3 VISAGES : colle ici 3 URLs de tes photos d'avis, séparées par |\n  Cadrage sur le visage : --gw-av-zoom et --gw-av-y dans le CSS.\n{%- endcomment -%}\n{%- assign gwp_av_raw = '' -%}\n{%- assign gwp_av = gwp_av_raw | split: '|' -%}\n\n{%- assign p = all_products[gwp_handle] -%}\n{%- if p == blank or p.id == nil -%}{%- assign p = collections.all.products.first -%}{%- endif -%}\n\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Archivo:ital,wght@0,400;0,500;0,600;0,700;0,900;1,700;1,900&display=swap\">\n\n<style>\n#gwpd-{{ section.id }}{\n  --gw-frame:#111111;\n  --gw-frame-w:1.5px;\n  --gw-neon:#F7A81B;\n  --gw-neon-rgb:247,168,27;\n  --gw-halo-0:.45; --gw-halo-1:.50; --gw-halo-2:.32; --gw-halo-3:.18;\n  --gw-ink:#111111;\n  --gw-ink2:#5A5A5A;\n  --gw-line:#E6E4DF;\n  --gw-radius:18px;\n  --gw-pad:24px;\n\n  /* --- cadrage des visages dans les ronds --- */\n  --gw-av-zoom:1.55;\n  --gw-av-y:16%;\n\n  background:#FFFFFF;\n  padding:34px var(--gw-pad) 46px !important;\n  margin:0 !important;\n  width:100%;\n  max-width:100%;\n  overflow-x:hidden;\n}\n#gwpd-{{ section.id }} *{box-sizing:border-box;}\n#gwpd-{{ section.id }} img{max-width:100%;display:block;}\n\n.gwpd-halo{\n  border:var(--gw-frame-w) solid var(--gw-frame);\n  border-radius:var(--gw-radius);\n  background:#FFFFFF;\n  box-shadow:\n    0 0 0 1px rgba(var(--gw-neon-rgb),var(--gw-halo-0)),\n    0 0 6px  rgba(var(--gw-neon-rgb),var(--gw-halo-1)),\n    0 0 16px rgba(var(--gw-neon-rgb),var(--gw-halo-2)),\n    0 0 34px rgba(var(--gw-neon-rgb),var(--gw-halo-3));\n}\n\n.gwpd-in{max-width:1180px;margin:0 auto;}\n\n/* ---------- GRILLE ---------- */\n.gwpd-grid{display:grid;grid-template-columns:1fr;gap:26px;align-items:start;}\n@media (min-width:900px){\n  .gwpd-grid{grid-template-columns:minmax(0,1.05fr) minmax(0,1fr);gap:44px;align-items:stretch;}\n  .gwpd-col--info{display:flex;flex-direction:column;}\n  .gwpd-loyal{margin-top:auto !important;}\n}\n.gwpd-col{min-width:0;margin:0;padding:0;}\n.gwpd-col > *:first-child{margin-top:0 !important;}\n\n/* ---------- MEDIA ---------- */\n.gwpd-main{overflow:hidden;aspect-ratio:4/5;margin:0;}\n.gwpd-main img{width:100%;height:100%;object-fit:cover;border-radius:calc(var(--gw-radius) - 2px);}\n.gwpd-thumbs{display:grid;grid-template-columns:repeat(5,1fr);gap:10px;margin-top:12px;}\n.gwpd-thumb{\n  padding:0;border:var(--gw-frame-w) solid var(--gw-line);border-radius:12px;\n  overflow:hidden;background:#fff;cursor:pointer;aspect-ratio:1/1;\n}\n.gwpd-thumb.is-on{\n  border-color:var(--gw-frame);\n  box-shadow:0 0 0 1px rgba(var(--gw-neon-rgb),.45),0 0 10px rgba(var(--gw-neon-rgb),.35);\n}\n.gwpd-thumb img{width:100%;height:100%;object-fit:cover;}\n\n/* ---------- PREUVE SOCIALE ---------- */\n.gwpd-social{display:flex;align-items:center;gap:12px;margin:0 0 14px;padding:0;}\n.gwpd-avas{display:flex;align-items:center;}\n.gwpd-av{\n  position:relative;\n  width:38px;height:38px;border-radius:999px;overflow:hidden;\n  border:2px solid #FFFFFF;box-shadow:0 0 0 1.5px var(--gw-frame);\n  margin-left:-11px;background:#111;\n  display:flex;align-items:center;justify-content:center;\n  font-family:'Archivo',sans-serif;font-weight:900;font-style:italic;\n  font-size:11px;color:#FFF;letter-spacing:-0.02em;flex:0 0 auto;\n}\n.gwpd-av:first-child{margin-left:0;}\n.gwpd-av img{\n  position:absolute;inset:0;width:100%;height:100%;\n  object-fit:cover;object-position:50% var(--gw-av-y);\n  transform:scale(var(--gw-av-zoom));transform-origin:50% var(--gw-av-y);\n}\n.gwpd-social p{\n  margin:0;font-family:'Archivo',sans-serif;font-weight:500;font-style:normal;\n  font-size:13.5px;line-height:1.35;color:var(--gw-ink2);\n}\n.gwpd-social b{font-weight:900;font-style:italic;color:var(--gw-ink);text-transform:uppercase;}\n\n/* ---------- TITRE / PRIX ---------- */\n.gwpd-title{\n  margin:0 0 6px;font-family:'Archivo',sans-serif;\n  font-weight:900;font-style:italic;text-transform:uppercase;\n  font-size:clamp(24px,3.4vw,38px);line-height:1.02;letter-spacing:-0.015em;color:var(--gw-ink);\n}\n.gwpd-sub{\n  margin:0 0 14px;font-family:'Archivo',sans-serif;font-weight:400;font-style:normal;\n  font-size:14.5px;line-height:1.5;color:var(--gw-ink2);\n}\n.gwpd-priceline{display:flex;align-items:baseline;gap:10px;flex-wrap:wrap;margin:0 0 18px;}\n.gwpd-price{\n  font-family:'Archivo',sans-serif;font-weight:900;font-style:italic;\n  font-size:30px;line-height:1;color:var(--gw-ink);\n}\n.gwpd-compare{\n  font-family:'Archivo',sans-serif;font-weight:500;font-style:normal;\n  font-size:16px;color:#9A9A9A;text-decoration:line-through;\n}\n.gwpd-tax{\n  font-family:'Archivo',sans-serif;font-weight:400;font-style:normal;\n  font-size:12.5px;color:var(--gw-ink2);\n}\n\n/* ---------- OPTIONS ---------- */\n.gwpd-opt{margin:0 0 18px;}\n.gwpd-optlabel{\n  display:flex;align-items:baseline;gap:8px;margin:0 0 9px;\n  font-family:'Archivo',sans-serif;font-weight:900;font-style:italic;\n  text-transform:uppercase;font-size:12.5px;letter-spacing:.04em;color:var(--gw-ink);\n}\n.gwpd-optlabel span{\n  font-weight:500;font-style:normal;text-transform:none;letter-spacing:0;\n  font-size:13px;color:var(--gw-ink2);\n}\n.gwpd-choices{display:flex;flex-wrap:wrap;gap:9px;}\n.gwpd-choice{\n  position:relative;min-height:44px;padding:0 16px;\n  display:inline-flex;align-items:center;justify-content:center;gap:9px;\n  background:#FFFFFF;color:var(--gw-ink);\n  border:var(--gw-frame-w) solid var(--gw-line);border-radius:999px;cursor:pointer;\n  font-family:'Archivo',sans-serif;font-weight:700;font-style:normal;\n  font-size:13.5px;line-height:1;text-transform:uppercase;letter-spacing:.02em;\n  transition:border-color .15s ease, box-shadow .15s ease;\n  -webkit-appearance:none;appearance:none;\n}\n.gwpd-choice:hover{border-color:#B9B6AF;}\n.gwpd-choice.is-on{\n  border-color:var(--gw-frame);\n  box-shadow:0 0 0 1px rgba(var(--gw-neon-rgb),.45),0 0 8px rgba(var(--gw-neon-rgb),.40),0 0 18px rgba(var(--gw-neon-rgb),.22);\n}\n.gwpd-choice.is-out{opacity:.38;}\n.gwpd-choice.is-out::after{\n  content:\"\";position:absolute;left:10%;right:10%;top:50%;height:1px;background:var(--gw-ink);\n}\n.gwpd-sw{width:17px;height:17px;border-radius:999px;border:1px solid rgba(0,0,0,.35);flex:0 0 auto;}\n\n/* ---------- QUANTITÉ ---------- */\n.gwpd-row{display:flex;gap:10px;align-items:stretch;margin:0 0 12px;}\n.gwpd-qty{\n  display:flex;align-items:center;\n  border:var(--gw-frame-w) solid var(--gw-frame);border-radius:999px;\n  overflow:hidden;background:#FFF;flex:0 0 auto;height:58px;\n}\n.gwpd-qbtn{\n  width:46px;height:100%;padding:0;margin:0;border:0;background:transparent;cursor:pointer;color:var(--gw-ink);\n  display:flex;align-items:center;justify-content:center;\n  font-family:'Archivo',sans-serif;font-weight:700;font-style:normal;font-size:20px;line-height:1;\n  -webkit-appearance:none;appearance:none;\n}\n.gwpd-qbtn span{display:block;line-height:1;transform:translateY(-1px);}\n.gwpd-qval{\n  width:40px;height:100%;border:0;background:transparent;text-align:center;padding:0;\n  font-family:'Archivo',sans-serif;font-weight:900;font-style:italic;font-size:16px;color:var(--gw-ink);\n  -moz-appearance:textfield;\n}\n.gwpd-qval::-webkit-outer-spin-button,\n.gwpd-qval::-webkit-inner-spin-button{-webkit-appearance:none;margin:0;}\n\n/* ---------- BOUTON ---------- */\n.gwpd-add{\n  flex:1 1 auto;display:flex;align-items:center;justify-content:center;text-align:center;\n  height:58px;padding:0 20px;margin:0;\n  background:var(--gw-neon);color:var(--gw-ink);\n  border:var(--gw-frame-w) solid var(--gw-frame);border-radius:999px;cursor:pointer;\n  font-family:'Archivo',sans-serif;font-weight:900;font-style:italic;\n  text-transform:uppercase;font-size:16px;line-height:1;letter-spacing:.01em;\n  box-shadow:0 0 0 1px rgba(var(--gw-neon-rgb),.35),0 0 12px rgba(var(--gw-neon-rgb),.35);\n  -webkit-appearance:none;appearance:none;\n  transition:transform .12s ease, box-shadow .15s ease;\n}\n.gwpd-add span{display:block;line-height:1;transform:translateY(-1px);}\n.gwpd-add:hover{box-shadow:0 0 0 1px rgba(var(--gw-neon-rgb),.5),0 0 20px rgba(var(--gw-neon-rgb),.5);}\n.gwpd-add:active{transform:translateY(1px);}\n.gwpd-add[disabled]{background:#DDD9D2;box-shadow:none;cursor:not-allowed;color:#7A7A7A;}\n\n/* ---------- BARRE LIVRAISON ---------- */\n.gwpd-ship{margin:0 0 4px;}\n.gwpd-shiptxt{\n  margin:0 0 7px;font-family:'Archivo',sans-serif;font-weight:500;font-style:normal;\n  font-size:12.5px;line-height:1.4;color:var(--gw-ink2);\n}\n.gwpd-shiptxt b{font-weight:900;font-style:italic;color:var(--gw-ink);}\n.gwpd-bar{height:8px;border-radius:999px;background:#F1EFEA;border:1px solid var(--gw-line);overflow:hidden;}\n.gwpd-barin{\n  height:100%;width:0%;background:var(--gw-neon);\n  box-shadow:0 0 8px rgba(var(--gw-neon-rgb),.6);transition:width .4s ease;\n}\n\n/* ---------- RÉASSURANCE (sous l'accroche) ---------- */\n.gwpd-re{list-style:none;margin:0 0 20px;padding:0;display:grid;gap:9px;}\n.gwpd-re li{\n  display:flex;gap:9px;align-items:flex-start;\n  font-family:'Archivo',sans-serif;font-weight:500;font-style:normal;\n  font-size:13.5px;line-height:1.45;color:var(--gw-ink2);\n}\n.gwpd-re b{font-weight:900;font-style:italic;color:var(--gw-ink);}\n.gwpd-dot{\n  flex:0 0 auto;width:7px;height:7px;border-radius:999px;margin-top:6px;\n  background:var(--gw-neon);box-shadow:0 0 6px rgba(var(--gw-neon-rgb),.7);\n}\n\n/* ---------- BANDEAU CLIENTS RÉCURRENTS ---------- */\n.gwpd-loyal{margin:22px 0 0;padding:16px 18px;text-align:center;}\n.gwpd-loyal-k{\n  font-family:'Archivo',sans-serif;font-weight:900;font-style:italic;\n  text-transform:uppercase;font-size:clamp(17px,2.1vw,23px);line-height:1.05;\n  letter-spacing:-0.015em;color:var(--gw-ink);margin:0;\n}\n.gwpd-loyal-k em{font-style:italic;color:var(--gw-neon);text-shadow:0 0 10px rgba(var(--gw-neon-rgb),.45);}\n.gwpd-loyal-s{\n  margin:6px 0 10px;font-family:'Archivo',sans-serif;font-weight:500;font-style:normal;\n  font-size:12.5px;line-height:1.45;color:var(--gw-ink2);\n}\n.gwpd-rot{position:relative;min-height:42px;}\n.gwpd-rot p{\n  position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);\n  width:100%;margin:0;\n  font-family:'Archivo',sans-serif;font-weight:700;font-style:italic;\n  font-size:13.5px;line-height:1.35;color:var(--gw-ink);\n  opacity:0;transition:opacity .45s ease;pointer-events:none;\n}\n.gwpd-rot p.is-on{opacity:1;}\n.gwpd-rot b{font-weight:900;color:var(--gw-neon);text-shadow:0 0 9px rgba(var(--gw-neon-rgb),.4);}\n.gwpd-dots{display:flex;gap:6px;justify-content:center;margin-top:10px;}\n.gwpd-dots i{width:6px;height:6px;border-radius:999px;background:#DCD8D1;display:block;transition:background .3s ease;}\n.gwpd-dots i.is-on{background:var(--gw-neon);box-shadow:0 0 7px rgba(var(--gw-neon-rgb),.7);}\n\n@media (max-width:899px){\n  #gwpd-{{ section.id }}{--gw-pad:16px;padding-top:24px !important;padding-bottom:34px !important;}\n  .gwpd-price{font-size:26px;}\n  .gwpd-loyal{margin-top:26px;}\n}\n</style>\n\n<div id=\"gwpd-{{ section.id }}\" class=\"gwpd\">\n<div class=\"gwpd-in\">\n\n{%- if p == blank or p.id == nil -%}\n  <p style=\"font-family:'Archivo',sans-serif;\">Produit introuvable — vérifie le handle <b>{{ gwp_handle }}</b>.</p>\n{%- else -%}\n\n  <div class=\"gwpd-grid\">\n\n    <!-- ============ COLONNE MEDIA ============ -->\n    <div class=\"gwpd-col\">\n      <div class=\"gwpd-main gwpd-halo\">\n        <img id=\"gwpdMain-{{ section.id }}\"\n             src=\"{{ p.featured_image | image_url: width: 1200 }}\"\n             alt=\"{{ p.title | escape }}\" loading=\"eager\" width=\"1200\" height=\"1500\">\n      </div>\n      {%- if p.images.size > 1 -%}\n      <div class=\"gwpd-thumbs\">\n        {%- for img in p.images limit: 5 -%}\n        <button type=\"button\" class=\"gwpd-thumb{% if forloop.first %} is-on{% endif %}\"\n                data-src=\"{{ img | image_url: width: 1200 }}\" aria-label=\"Photo {{ forloop.index }}\">\n          <img src=\"{{ img | image_url: width: 300 }}\" alt=\"\" loading=\"lazy\" width=\"300\" height=\"300\">\n        </button>\n        {%- endfor -%}\n      </div>\n      {%- endif -%}\n    </div>\n\n    <!-- ============ COLONNE INFOS ============ -->\n    <div class=\"gwpd-col gwpd-col--info\">\n\n      <div class=\"gwpd-social\">\n        <div class=\"gwpd-avas\">\n          {%- if gwp_av.size > 0 -%}\n            {%- for a in gwp_av -%}<span class=\"gwpd-av\"><img src=\"{{ a | strip }}\" alt=\"\" loading=\"lazy\"></span>{%- endfor -%}\n          {%- else -%}\n            <span class=\"gwpd-av\">G</span><span class=\"gwpd-av\">W</span><span class=\"gwpd-av\">91</span>\n          {%- endif -%}\n        </div>\n        <p><b>{{ gwp_clients }} clients</b> ont déjà commandé Grignywood — {{ gwp_commandes }} commandes livrées</p>\n      </div>\n\n      <h1 class=\"gwpd-title\">{{ p.title }}</h1>\n      <p class=\"gwpd-sub\">Coton lourd 350 g/m². Coupe droite, épaules tombantes. Fabriqué pour durer, dessiné à Grigny.</p>\n\n      <ul class=\"gwpd-re\">\n        <li><i class=\"gwpd-dot\"></i><span><b>350 g/m²</b> — le tissu ne se voit pas à travers, même en blanc.</span></li>\n        <li><i class=\"gwpd-dot\"></i><span><b>Expédié de France</b> — préparé et posté depuis l'Essonne.</span></li>\n        <li><i class=\"gwpd-dot\"></i><span><b>Livraison offerte</b> dès 50 € d'achat.</span></li>\n        <li><i class=\"gwpd-dot\"></i><span><b>Échange ou remboursement</b> sous 14 jours, article non porté.</span></li>\n      </ul>\n\n      {%- form 'product', p -%}\n        <input type=\"hidden\" name=\"id\" value=\"{{ p.selected_or_first_available_variant.id }}\" id=\"gwpdId-{{ section.id }}\">\n\n        <div class=\"gwpd-priceline\">\n          <span class=\"gwpd-price\" id=\"gwpdPrice-{{ section.id }}\">{{ p.selected_or_first_available_variant.price | money }}</span>\n          {%- if p.compare_at_price > p.price -%}\n          <span class=\"gwpd-compare\" id=\"gwpdCompare-{{ section.id }}\">{{ p.compare_at_price | money }}</span>\n          {%- endif -%}\n          <span class=\"gwpd-tax\">TVA incluse · livraison calculée au paiement</span>\n        </div>\n\n        {%- for opt in p.options_with_values -%}\n        <div class=\"gwpd-opt\">\n          <div class=\"gwpd-optlabel\">\n            {{ opt.name }} : <span id=\"gwpdOptVal-{{ section.id }}-{{ forloop.index0 }}\"></span>\n          </div>\n          <div class=\"gwpd-choices\">\n            {%- for v in opt.values -%}\n              {%- assign vlow = v | downcase -%}\n              {%- assign swatch = '' -%}\n              {%- if vlow contains 'noir' or vlow contains 'black' -%}{%- assign swatch = '#111111' -%}{%- endif -%}\n              {%- if vlow contains 'blanc' or vlow contains 'white' or vlow contains 'beige' -%}{%- assign swatch = '#FFFFFF' -%}{%- endif -%}\n              <button type=\"button\" class=\"gwpd-choice\"\n                      data-opt=\"{{ forloop.parentloop.index0 }}\"\n                      data-val=\"{{ v | escape }}\">\n                {%- if swatch != '' -%}<i class=\"gwpd-sw\" style=\"background:{{ swatch }}\"></i>{%- endif -%}\n                {{ v }}\n              </button>\n            {%- endfor -%}\n          </div>\n        </div>\n        {%- endfor -%}\n\n        <div class=\"gwpd-row\">\n          <div class=\"gwpd-qty\">\n            <button type=\"button\" class=\"gwpd-qbtn\" data-q=\"-1\" aria-label=\"Retirer\"><span>&#8722;</span></button>\n            <input class=\"gwpd-qval\" type=\"number\" name=\"quantity\" value=\"1\" min=\"1\" id=\"gwpdQty-{{ section.id }}\" inputmode=\"numeric\">\n            <button type=\"button\" class=\"gwpd-qbtn\" data-q=\"1\" aria-label=\"Ajouter\"><span>&#43;</span></button>\n          </div>\n          <button type=\"submit\" class=\"gwpd-add\" id=\"gwpdAdd-{{ section.id }}\"><span>Ajouter au panier</span></button>\n        </div>\n\n        <div class=\"gwpd-ship\">\n          <p class=\"gwpd-shiptxt\" id=\"gwpdShipTxt-{{ section.id }}\">\n            Livraison offerte dès <b>50,00 €</b> d'achat\n          </p>\n          <div class=\"gwpd-bar\"><div class=\"gwpd-barin\" id=\"gwpdBar-{{ section.id }}\"></div></div>\n        </div>\n\n      {%- endform -%}\n\n      <!-- ===== CLIENTS RÉCURRENTS — collé en bas du cadre image ===== -->\n      <div class=\"gwpd-loyal gwpd-halo\">\n        <p class=\"gwpd-loyal-k\"><em>{{ gwp_fideles }}</em> clients sont revenus commander</p>\n        <p class=\"gwpd-loyal-s\">Sur {{ gwp_clients }} clients et {{ gwp_commandes }} commandes depuis 2020.</p>\n        <div class=\"gwpd-rot\" id=\"gwpdRot-{{ section.id }}\">\n          <p class=\"is-on\"><b>{{ gwp_partfid }} %</b> des commandes viennent d'un client qui avait déjà acheté.</p>\n          <p><b>{{ gwp_commandes }}</b> commandes préparées et expédiées à la main depuis Grigny.</p>\n          <p><b>{{ gwp_abonnes }}</b> personnes suivent Grignywood sur Instagram et Facebook.</p>\n        </div>\n        <div class=\"gwpd-dots\" id=\"gwpdDots-{{ section.id }}\"><i class=\"is-on\"></i><i></i><i></i></div>\n      </div>\n\n    </div>\n  </div>\n\n{%- endif -%}\n\n</div>\n</div>\n\n{%- if p != blank and p.id != nil -%}\n<script>\n(function(){\n  var SID  = {{ section.id | json }};\n  var root = document.getElementById('gwpd-' + SID);\n  if(!root) return;\n\n  var VARIANTS = {{ p.variants | json }};\n  var NOPT     = {{ p.options.size }};\n\n  var idIn   = document.getElementById('gwpdId-' + SID);\n  var priceE = document.getElementById('gwpdPrice-' + SID);\n  var compE  = document.getElementById('gwpdCompare-' + SID);\n  var addB   = document.getElementById('gwpdAdd-' + SID);\n  var mainI  = document.getElementById('gwpdMain-' + SID);\n  var qtyIn  = document.getElementById('gwpdQty-' + SID);\n\n  function money(c){\n    return (c/100).toFixed(2).replace('.', ',').replace(/\\B(?=(\\d{3})+(?!\\d))/g, ' ') + ' €';\n  }\n\n  var sel = [];\n  var start = VARIANTS.filter(function(v){ return v.available; })[0] || VARIANTS[0];\n  for(var i=0;i<NOPT;i++){ sel[i] = start['option'+(i+1)]; }\n\n  function findVariant(s){\n    for(var i=0;i<VARIANTS.length;i++){\n      var v = VARIANTS[i], ok = true;\n      for(var k=0;k<NOPT;k++){ if(v['option'+(k+1)] !== s[k]){ ok = false; break; } }\n      if(ok) return v;\n    }\n    return null;\n  }\n\n  function valueAvailable(idx, val){\n    for(var i=0;i<VARIANTS.length;i++){\n      var v = VARIANTS[i];\n      if(!v.available) continue;\n      if(v['option'+(idx+1)] !== val) continue;\n      var ok = true;\n      for(var k=0;k<NOPT;k++){\n        if(k === idx) continue;\n        if(v['option'+(k+1)] !== sel[k]){ ok = false; break; }\n      }\n      if(ok) return true;\n    }\n    return false;\n  }\n\n  var btns = Array.prototype.slice.call(root.querySelectorAll('.gwpd-choice'));\n\n  function render(){\n    btns.forEach(function(b){\n      var i   = parseInt(b.getAttribute('data-opt'), 10);\n      var val = b.getAttribute('data-val');\n      if(val === sel[i]) b.classList.add('is-on'); else b.classList.remove('is-on');\n      if(valueAvailable(i, val)) b.classList.remove('is-out'); else b.classList.add('is-out');\n      b.setAttribute('aria-pressed', val === sel[i] ? 'true' : 'false');\n    });\n\n    for(var i=0;i<NOPT;i++){\n      var lab = document.getElementById('gwpdOptVal-' + SID + '-' + i);\n      if(lab) lab.textContent = sel[i] || '';\n    }\n\n    var v = findVariant(sel);\n    if(v){\n      if(idIn) idIn.value = v.id;\n      if(priceE) priceE.textContent = money(v.price);\n      if(compE){\n        if(v.compare_at_price && v.compare_at_price > v.price){\n          compE.textContent = money(v.compare_at_price); compE.style.display = '';\n        } else { compE.style.display = 'none'; }\n      }\n      if(v.featured_image && v.featured_image.src && mainI){ mainI.src = v.featured_image.src; }\n      if(v.available){\n        addB.removeAttribute('disabled');\n        addB.querySelector('span').textContent = 'Ajouter au panier';\n      } else {\n        addB.setAttribute('disabled','disabled');\n        addB.querySelector('span').textContent = 'Rupture de stock';\n      }\n    } else {\n      addB.setAttribute('disabled','disabled');\n      addB.querySelector('span').textContent = 'Combinaison indisponible';\n    }\n  }\n\n  btns.forEach(function(b){\n    b.addEventListener('click', function(e){\n      e.preventDefault();\n      var i = parseInt(b.getAttribute('data-opt'), 10);\n      sel[i] = b.getAttribute('data-val');\n      render();\n    });\n  });\n\n  root.querySelectorAll('.gwpd-qbtn').forEach(function(b){\n    b.addEventListener('click', function(){\n      var n = parseInt(qtyIn.value, 10); if(isNaN(n)) n = 1;\n      n += parseInt(b.getAttribute('data-q'), 10);\n      if(n < 1) n = 1;\n      qtyIn.value = n;\n    });\n  });\n\n  var thumbs = root.querySelectorAll('.gwpd-thumb');\n  thumbs.forEach(function(t){\n    t.addEventListener('click', function(){\n      thumbs.forEach(function(x){ x.classList.remove('is-on'); });\n      t.classList.add('is-on');\n      if(mainI) mainI.src = t.getAttribute('data-src');\n    });\n  });\n\n  var FREE = {{ gwp_freeship }};\n  var barE = document.getElementById('gwpdBar-' + SID);\n  var txtE = document.getElementById('gwpdShipTxt-' + SID);\n  function setBar(total){\n    var pct = Math.max(0, Math.min(100, (total / FREE) * 100));\n    if(barE) barE.style.width = pct + '%';\n    if(!txtE) return;\n    if(total >= FREE){\n      txtE.innerHTML = '<b>Livraison offerte débloquée.</b>';\n    } else if(total <= 0){\n      txtE.innerHTML = 'Livraison offerte dès <b>' + money(FREE) + '</b> d\\'achat';\n    } else {\n      txtE.innerHTML = 'Plus que <b>' + money(FREE - total) + '</b> pour la livraison offerte';\n    }\n  }\n  setBar(0);\n  if(window.fetch){\n    fetch('/cart.js', {headers:{'Accept':'application/json'}})\n      .then(function(r){ return r.json(); })\n      .then(function(c){ setBar(c.total_price || 0); })\n      .catch(function(){});\n  }\n\n  var rot  = document.getElementById('gwpdRot-' + SID);\n  var dots = document.getElementById('gwpdDots-' + SID);\n  if(rot){\n    var ps = rot.querySelectorAll('p');\n    var ds = dots ? dots.querySelectorAll('i') : [];\n    var k  = 0;\n    setInterval(function(){\n      ps[k].classList.remove('is-on'); if(ds[k]) ds[k].classList.remove('is-on');\n      k = (k + 1) % ps.length;\n      ps[k].classList.add('is-on');    if(ds[k]) ds[k].classList.add('is-on');\n    }, 4200);\n  }\n\n  render();\n})();\n</script>\n{%- endif -%}",
