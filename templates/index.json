    "custom_liquid_9bAJEx": {
      "type": "custom-liquid",
      "name": "Custom Liquid",
      "settings": {
        "full_width": true,
        "remove_vertical_spacing": true,
        "remove_horizontal_spacing": true,
        "liquid": "<div class=\"gwb\">\n  <h2 class=\"gwb-title\">Pourquoi tu vas kiffer ton Grignywood</h2>\n\n  <div class=\"gwb-grid\">\n\n    <!-- MOBILE : les 3 principaux -->\n    <div class=\"gwb-card gwb-b1\">\n      <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M2 5c4-2 7-2 10 0 3-2 6-2 10 0v14c-4-2-7-2-10 0-3-2-6-2-10 0V5z\"/><path d=\"M12 5v14\"/></svg>\n      <span>Tu portes une histoire vraie</span>\n    </div>\n\n    <div class=\"gwb-card gwb-b4\">\n      <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 20s-7-4.5-7-9a4 4 0 0 1 7-2.6A4 4 0 0 1 19 11c0 4.5-7 9-7 9z\"/></svg>\n      <!-- version courte pour tenir sur 1 ligne : Ton argent change des choses -->\n      <span>Ton argent sert enfin à quelque chose</span>\n    </div>\n\n    <div class=\"gwb-card gwb-b3\">\n      <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><circle cx=\"8.5\" cy=\"9\" r=\"3\"/><circle cx=\"16\" cy=\"9.5\" r=\"2.4\"/><path d=\"M3 20c0-3.3 2.5-5.5 5.5-5.5S14 16.7 14 20\"/><path d=\"M14.5 20c0-2.6 1.8-4.4 4-4.4 1.4 0 2.5.6 3.2 1.6\"/></svg>\n      <span>Tu entres dans une famille</span>\n    </div>\n\n    <!-- L'IMAGE -->\n    <figure class=\"gwb-media\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0980/1724/7556/files/ChatGPT_Image_13_sept._2026_17_19_32.png?v=1789313291\"\n           alt=\"T-shirt Grignywood oversize noir, coton lourd 350 g\" loading=\"lazy\">\n    </figure>\n\n    <!-- MOBILE : les 3 suivants -->\n    <div class=\"gwb-card gwb-b2\">\n      <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M5.6 18.4 18.4 5.6\"/></svg>\n      <!-- version courte pour tenir sur 1 ligne : Fini les logos vides -->\n      <span>Fini les logos de tout le monde</span>\n    </div>\n\n    <div class=\"gwb-card gwb-b5\">\n      <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M3 21V11l4-3v13M11 21V7l5-4v18M19 21v-8l2 1.6V21\"/><path d=\"M2 21h20\"/></svg>\n      <span>Tu représentes les tiens</span>\n    </div>\n\n    <div class=\"gwb-card gwb-b6\">\n      <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"8\" r=\"3.2\"/><path d=\"M5 21c0-4 3.1-6.5 7-6.5s7 2.5 7 6.5\"/></svg>\n      <span>Tu te ressembles enfin</span>\n    </div>\n\n  </div>\n</div>\n\n<style>\n@import url('https://fonts.googleapis.com/css2?family=Archivo:ital,wght@1,900&display=swap');\n\n.gwb{\n  /* ================= RÉGLAGES ================= */\n  --gw-bg:#FFFFFF;         /* fond de section — #0E0E0E pour la version sombre */\n  --gw-ink:#111111;        /* texte — #FFFFFF en version sombre */\n  --gw-neon:#FFA800;       /* orange néon */\n  --gw-neon-rgb:255,168,0; /* le même en RGB, pour les halos */\n  --gw-card-bg:#FFFFFF;    /* fond des encadrés — #151515 en version sombre */\n  --gw-grid-max:1440px;    /* largeur de la zone bénéfices */\n  --gw-img-max:500px;      /* largeur du packshot */\n  /* ============================================ */\n\n  background:var(--gw-bg);\n  color:var(--gw-ink);\n  padding:60px 24px 68px;\n  box-sizing:border-box;\n}\n\n/* GRAND TITRE DE SECTION — standard commun à tout le site.\n   Identique à « ON NOUS A VU DANS ». Ne pas modifier isolément. */\n.gwb-title{\n  font-family:'Archivo',system-ui,sans-serif;\n  font-weight:900;font-style:italic;text-transform:uppercase;\n  text-align:center;color:var(--gw-ink);\n  font-size:clamp(22px,3.4vw,38px);\n  line-height:1.05;letter-spacing:-0.015em;\n  margin:0 0 44px;\n}\n\n.gwb-grid{\n  display:grid;\n  grid-template-columns:1fr;\n  gap:16px;\n  max-width:var(--gw-grid-max);\n  margin:0 auto;\n  align-items:center;\n}\n\n/* ---------- ENCADRÉS NÉON ---------- */\n.gwb-card{\n  display:flex;align-items:center;gap:16px;\n  background:var(--gw-card-bg);\n  border:2.5px solid var(--gw-neon);\n  border-radius:14px;\n  padding:16px 20px;\n  box-sizing:border-box;\n  box-shadow:\n    0 0 0 1px rgba(var(--gw-neon-rgb),.95),\n    0 0 9px rgba(var(--gw-neon-rgb),.95),\n    0 0 24px rgba(var(--gw-neon-rgb),.62),\n    0 0 44px rgba(var(--gw-neon-rgb),.34),\n    inset 0 0 14px rgba(var(--gw-neon-rgb),.30);\n}\n.gwb-card span{\n  flex:1;\n  text-wrap:normal;\n  font-family:'Archivo',system-ui,sans-serif;\n  font-weight:900;font-style:italic;text-transform:uppercase;\n  font-size:15px;line-height:1.25;letter-spacing:-0.02em;\n  color:var(--gw-ink);\n}\n.gwb-card svg{\n  flex:0 0 auto;width:26px;height:26px;\n  fill:none;stroke:var(--gw-neon);stroke-width:2;\n  stroke-linecap:round;stroke-linejoin:round;\n  filter:drop-shadow(0 0 3px rgba(var(--gw-neon-rgb),1))\n         drop-shadow(0 0 9px rgba(var(--gw-neon-rgb),.7));\n}\n\n/* ---------- IMAGE ---------- */\n.gwb-media{\n  margin:8px auto;\n  padding:16px;\n  background:var(--gw-card-bg);\n  border:2.5px solid var(--gw-neon);\n  border-radius:18px;\n  box-sizing:border-box;\n  max-width:var(--gw-img-max);\n  width:100%;\n  box-shadow:\n    0 0 0 1px rgba(var(--gw-neon-rgb),.95),\n    0 0 12px rgba(var(--gw-neon-rgb),.95),\n    0 0 34px rgba(var(--gw-neon-rgb),.66),\n    0 0 64px rgba(var(--gw-neon-rgb),.36),\n    inset 0 0 20px rgba(var(--gw-neon-rgb),.24);\n}\n.gwb-media img{display:block;width:100%;height:auto;border-radius:8px;}\n\n/* ---------- DESKTOP : 3 à gauche · image · 3 à droite ---------- */\n@media(min-width:900px){\n  .gwb-grid{\n    grid-template-columns:1fr minmax(300px,var(--gw-img-max)) 1fr;\n    grid-template-rows:repeat(3,auto);\n    gap:26px 46px;\n  }\n  .gwb-b1{grid-column:1;grid-row:1;}\n  .gwb-b3{grid-column:1;grid-row:2;}\n  .gwb-b5{grid-column:1;grid-row:3;}\n\n  .gwb-media{grid-column:2;grid-row:1 / span 3;margin:0;}\n\n  .gwb-b2{grid-column:3;grid-row:1;}\n  .gwb-b4{grid-column:3;grid-row:2;}\n  .gwb-b6{grid-column:3;grid-row:3;}\n\n  .gwb-card{padding:22px 24px;min-height:110px;gap:16px;}\n  .gwb-card span{font-size:17px;}\n  .gwb-card svg{width:30px;height:30px;}\n\n  /* colonne gauche : icône à l'extérieur, texte aligné vers le produit */\n  .gwb-b1,.gwb-b3,.gwb-b5{flex-direction:row-reverse;}\n  .gwb-b1 span,.gwb-b3 span,.gwb-b5 span{text-align:right;}\n\n  /* colonne droite : icône à l'extérieur, texte aligné vers le produit */\n  .gwb-b2 span,.gwb-b4 span,.gwb-b6 span{text-align:left;}\n}\n</style>",
