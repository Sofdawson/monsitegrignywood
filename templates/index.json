   <div class=\"gw-set\" aria-hidden=\"true\">\n        <div class=\"gw-item\"><img src=\"https://cdn.shopify.com/s/files/1/0980/1724/7556/files/france_tv.png?v=1786025451\" alt=\"\"></div>\n        <div class=\"gw-item\"><img src=\"https://cdn.shopify.com/s/files/1/0980/1724/7556/files/le_monde.png?v=1786025477\" alt=\"\"></div>\n        <div class=\"gw-item\"><img src=\"https://cdn.shopify.com/s/files/1/0980/1724/7556/files/bfm_tv.jpg?v=1786025496\" alt=\"\"></div>\n        <div class=\"gw-item\"><img src=\"https://cdn.shopify.com/s/files/1/0980/1724/7556/files/Le_Parisien.jpg?v=1786025514\" alt=\"\"></div>\n        <div class=\"gw-item\"><img src=\"https://cdn.shopify.com/s/files/1/0980/1724/7556/files/logo_france_24.png?v=1786025531\" alt=\"\"></div>\n      </div>\n\n    </div>\n  </div>\n</div>\n\n<style>\n.gw-press{\n  /* ============ RÉGLAGES ============ */\n  --gw-bg:#FFFFFF;        /* fond du bandeau */\n  --gw-ink:#111111;       /* noir de la marque */\n  --gw-rule:#EAE8E3;      /* filet haut/bas — mettre transparent pour l'enlever */\n  --s:0.60;               /* échelle globale des logos */\n  --gw-gap:34px;          /* espacement logo ↔ point */\n  --gw-dot:7px;           /* diamètre du point séparateur */\n  --gw-dot-color:#111111; /* couleur du point */\n  --gw-dot-opacity:.30;   /* opacité du point */\n  --gw-fade:90px;         /* largeur du fondu sur les bords */\n  --gw-speed:34s;         /* durée d'un cycle */\n  /* ================================== */\n\n  width:100vw;\n  max-width:100vw;\n  margin-left:calc(50% - 50vw);\n  margin-right:calc(50% - 50vw);\n\n  background:var(--gw-bg);\n  border-top:1px solid var(--gw-rule);\n  border-bottom:1px solid var(--gw-rule);\n  padding:34px 0 38px;\n  overflow:hidden;\n}\n.gw-press *{box-sizing:border-box;}\n\n.gw-press-title{\n  font-family:'Archivo',system-ui,-apple-system,sans-serif !important;\n  font-weight:900 !important;\n  font-style:italic !important;\n  text-align:center;\n  color:var(--gw-ink);\n  font-size:clamp(20px,3.1vw,34px);\n  line-height:1.05;\n  letter-spacing:-0.01em;\n  text-transform:uppercase;\n  margin:0 0 26px;\n  padding:0;\n}\n\n.gw-viewport{\n  overflow:hidden;\n  width:100%;\n  -webkit-mask-image:linear-gradient(to right,transparent 0,#000 var(--gw-fade),#000 calc(100% - var(--gw-fade)),transparent 100%);\n  mask-image:linear-gradient(to right,transparent 0,#000 var(--gw-fade),#000 calc(100% - var(--gw-fade)),transparent 100%);\n}\n\n.gw-track{\n  display:flex;\n  align-items:center;\n  gap:var(--gw-gap);\n  width:max-content;\n  animation:gwScroll var(--gw-speed) linear infinite;\n}\n.gw-track:hover{animation-play-state:paused;}\n\n.gw-set{\n  display:flex;\n  align-items:center;\n  gap:var(--gw-gap);\n  flex:0 0 auto;\n}\n\n/* Plus aucun cadre : le logo, puis le point séparateur */\n.gw-item{\n  flex:0 0 auto;\n  display:flex;\n  align-items:center;\n  gap:var(--gw-gap);\n  background:none;\n  border:0;\n  padding:0;\n}\n\n.gw-item::after{\n  content:\"\";\n  flex:0 0 auto;\n  width:var(--gw-dot);\n  height:var(--gw-dot);\n  border-radius:50%;\n  background:var(--gw-dot-color);\n  opacity:var(--gw-dot-opacity);\n}\n\n.gw-item img{\n  width:auto;\n  max-width:none;\n  display:block;\n  object-fit:contain;\n}\n\n/* ---- HAUTEUR DE CHAQUE LOGO ---- */\n.gw-item:nth-child(1) img{height:calc(90px  * var(--s));} /* France TV   */\n.gw-item:nth-child(2) img{height:calc(150px * var(--s));} /* Le Monde    */\n.gw-item:nth-child(3) img{height:calc(65px  * var(--s));} /* BFM TV      */\n.gw-item:nth-child(4) img{height:calc(160px * var(--s));} /* Le Parisien */\n.gw-item:nth-child(5) img{height:calc(65px  * var(--s));} /* France 24   */\n\n@media(max-width:749px){\n  .gw-press{--s:0.46; --gw-gap:18px; --gw-dot:5px; --gw-fade:40px; --gw-speed:24s; padding:22px 0 26px;}\n  .gw-press-title{font-size:19px;margin:0 0 16px;}\n}\n\n@media(prefers-reduced-motion:reduce){\n  .gw-track{animation:none;}\n}\n\n/* Trois séries : le décalage vaut un tiers de