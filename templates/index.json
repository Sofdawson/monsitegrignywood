    "custom_liquid_yHzGix": {
      "type": "custom-liquid",
      "name": "Custom Liquid",
      "settings": {
        "full_width": true,
        "remove_vertical_spacing": true,
        "remove_horizontal_spacing": true,
        "liquid": "<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Archivo:ital,wght@0,500;0,700;1,900&display=swap\">\n\n<div class=\"gwq\">\n  <div class=\"gwq-inner\">\n\n    <figure class=\"gwq-media\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0980/1724/7556/files/ChatGPT_Image_18_sept._2026_23_03_53.png?v=1789765520\"\n           alt=\"T-shirt Grignywood oversize noir sur cintre, coton lourd 350 g\" loading=\"lazy\">\n    </figure>\n\n    <div class=\"gwq-txt\">\n      <p class=\"gwq-kicker\">La matière</p>\n\n      <h2 class=\"gwq-title\">La qualité du luxe, sans son prix</h2>\n\n      <p class=\"gwq-body\">\n        100 % coton naturel, 350 grammes au mètre carré. Un tissu épais, dense et\n        opaque, qui garde sa forme lavage après lavage au lieu de finir en chiffon.\n        Dessiné en France, tissé et confectionné en Turquie, l'un des grands pays\n        du textile et du coton en Méditerranée. La coupe est oversize, taillée\n        large aux épaules et au buste, pour un confort qui ne se négocie pas.\n      </p>\n\n      <p class=\"gwq-body\">\n        C'est exactement le cahier des charges des grandes marques. La différence,\n        c'est qu'on vend en direct : pas de boutique à payer, pas d'intermédiaire\n        à rémunérer, pas de marge de distributeur. Ce que vous payez, c'est le\n        vêtement — pas la chaîne qui le vend.\n      </p>\n\n      <ul class=\"gwq-list\">\n        <li><svg viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><path d=\"m7.5 12.4 3.2 3.2 6-6.6\"/></svg><span>100 % coton, 350 g/m²</span></li>\n        <li><svg viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><path d=\"m7.5 12.4 3.2 3.2 6-6.6\"/></svg><span>Dessiné en France, tissé en Turquie</span></li>\n        <li><svg viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><path d=\"m7.5 12.4 3.2 3.2 6-6.6\"/></svg><span>Coupe oversize, confort maximum</span></li>\n        <li><svg viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><path d=\"m7.5 12.4 3.2 3.2 6-6.6\"/></svg><span>Vendu en direct, sans intermédiaire</span></li>\n        <li><svg viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><path d=\"m7.5 12.4 3.2 3.2 6-6.6\"/></svg><span>Les bénéfices financent nos projets</span></li>\n      </ul>\n\n      <!-- ══════ ZOOM SUR LA MATIÈRE ══════ -->\n      <div class=\"gwq-zoom\">\n        <button class=\"gwq-zoom-circle\" type=\"button\"\n                data-gwq-zoomable\n                data-gwq-src=\"https://cdn.shopify.com/s/files/1/0980/1724/7556/files/ChatGPT_Image_18_sept._2026_22_04_07.png?v=1789762064\"\n                aria-label=\"Agrandir le zoom sur la matière\">\n          <img src=\"https://cdn.shopify.com/s/files/1/0980/1724/7556/files/ChatGPT_Image_18_sept._2026_22_04_07.png?v=1789762064\"\n               alt=\"Zoom sur la maille du coton 350 g\" loading=\"lazy\">\n          <span class=\"gwq-zoom-icon\" aria-hidden=\"true\">\n            <svg viewBox=\"0 0 24 24\"><circle cx=\"11\" cy=\"11\" r=\"7\"/><path d=\"M20 20l-4.3-4.3M11 8v6M8 11h6\"/></svg>\n          </span>\n        </button>\n\n        <div class=\"gwq-zoom-txt\">\n          <p class=\"gwq-zoom-label\">Zoom sur la matière</p>\n          <p class=\"gwq-zoom-spec\">100 % coton<br>350 g</p>\n          <p class=\"gwq-zoom-hint\">Cliquez pour agrandir</p>\n        </div>\n      </div>\n\n    </div>\n\n  </div>\n\n  <!-- ══════ VISIONNEUSE PLEIN ÉCRAN ══════ -->\n  <div class=\"gwq-lightbox\" id=\"gwqLightbox\" role=\"dialog\" aria-modal=\"true\" aria-label=\"Zoom sur la matière\" hidden>\n    <button class=\"gwq-lightbox-close\" type=\"button\" aria-label=\"Fermer\">\n      <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M6 6l12 12M18 6L6 18\"/></svg>\n    </button>\n    <img src=\"\" alt=\"Zoom sur la maille du coton 350 g\">\n  </div>\n</div>\n\n<style>\n.gwq{\n  /* ================= RÉGLAGES ================= */\n  --gw-bg:#FFFFFF;\n  --gw-ink:#111111;\n  --gw-accent:#F5C518;        /* orange de la marque */\n  --gw-border:2px;\n  --gw-frame-pad:26px;        /* épaisseur du cadre orange autour de la photo */\n  --gw-tilt:-1.6deg;          /* inclinaison de la photo principale */\n  --gw-max:1560px;\n  --gw-img-col:44%;           /* largeur de la colonne image sur desktop */\n  --gw-zoom-size:170px;       /* diamètre du cercle de zoom */\n  --gw-zoom-ring:7px;         /* épaisseur de l'anneau orange */\n  --gw-zoom-gap:34px;         /* espace au-dessus du bloc zoom */\n  --gw-zoom-pos:50% 50%;      /* cadrage du macro dans le cercle */\n  --gw-lb-size:min(86vw, 86vh); /* diamètre du cercle agrandi */\n  --gw-lb-ring:10px;          /* épaisseur de l'anneau agrandi */\n  /* ============================================ */\n\n  width:100vw;\n  max-width:100vw;\n  margin-left:calc(50% - 50vw);\n  margin-right:calc(50% - 50vw);\n  box-sizing:border-box;\n  background:var(--gw-bg);\n  color:var(--gw-ink);\n  padding:64px 24px 72px;\n  font-family:'Archivo',system-ui,sans-serif;\n}\n.gwq *{box-sizing:border-box;}\n\n.gwq-inner{\n  max-width:var(--gw-max);\n  margin:0 auto;\n  display:grid;\n  grid-template-columns:1fr;\n  gap:34px;\n  align-items:center;\n}\n\n/* ---------- CADRE IMAGE PRINCIPALE ---------- */\n.gwq-media{\n  margin:0;\n  background:var(--gw-accent);\n  border:var(--gw-border) solid var(--gw-ink);\n  padding:var(--gw-frame-pad);\n  overflow:hidden;\n}\n.gwq-media img{\n  display:block;\n  width:100%;\n  height:auto;\n  border:3px solid var(--gw-ink);\n  transform:rotate(var(--gw-tilt));\n}\n\n/* ---------- TEXTE ---------- */\n.gwq-kicker{\n  margin:0 0 16px;\n  font-family:'Archivo',system-ui,sans-serif;\n  font-weight:900;font-style:italic;text-transform:uppercase;\n  font-size:clamp(13px,1.15vw,16px);\n  letter-spacing:.02em;\n}\n\n/* GRAND TITRE DE SECTION — standard commun à tout le site. */\n.gwq-title{\n  margin:0 0 22px;\n  font-family:'Archivo',system-ui,sans-serif;\n  font-weight:900;font-style:italic;text-transform:uppercase;\n  font-size:clamp(22px,3.4vw,38px);\n  line-height:1.05;letter-spacing:-0.015em;\n  text-wrap:balance;\n}\n\n.gwq-body{\n  margin:0 0 16px;\n  font-family:'Archivo',system-ui,sans-serif;\n  font-weight:500;font-style:normal;\n  font-size:clamp(14px,1.15vw,16px);\n  line-height:1.62;\n  max-width:62ch;\n}\n.gwq-body:last-of-type{margin-bottom:30px;}\n\n.gwq-list{\n  list-style:none;margin:0;padding:0;\n  display:flex;flex-direction:column;gap:16px;\n}\n.gwq-list li{\n  display:flex;align-items:center;gap:12px;\n}\n.gwq-list svg{\n  flex:0 0 auto;width:26px;height:26px;\n  fill:none;stroke:var(--gw-ink);stroke-width:2;\n  stroke-linecap:round;stroke-linejoin:round;\n  background:var(--gw-accent);\n  border-radius:50%;\n}\n.gwq-list span{\n  font-family:'Archivo',system-ui,sans-serif;\n  font-weight:900;font-style:italic;text-transform:uppercase;\n  font-size:clamp(15px,1.5vw,21px);\n  line-height:1.15;letter-spacing:-0.015em;\n}\n\n/* ---------- ZOOM SUR LA MATIÈRE ---------- */\n.gwq-zoom{\n  margin-top:var(--gw-zoom-gap);\n  display:flex;\n  align-items:center;\n  gap:24px;\n}\n\n.gwq-zoom-circle{\n  position:relative;\n  flex:0 0 auto;\n  width:var(--gw-zoom-size);\n  height:var(--gw-zoom-size);\n  padding:0;\n  border-radius:50%;\n  border:var(--gw-zoom-ring) solid var(--gw-accent);\n  background:#111;\n  overflow:hidden;\n  box-shadow:0 6px 18px rgba(0,0,0,.18);\n  cursor:zoom-in;\n  transition:transform .25s ease, box-shadow .25s ease;\n}\n.gwq-zoom-circle:hover{transform:scale(1.04);box-shadow:0 10px 26px rgba(0,0,0,.26);}\n.gwq-zoom-circle img{\n  display:block;\n  width:100%;\n  height:100%;\n  object-fit:cover;\n  object-position:var(--gw-zoom-pos);\n}\n.gwq-zoom-icon{\n  position:absolute;\n  right:8px;bottom:8px;\n  width:30px;height:30px;\n  border-radius:50%;\n  background:var(--gw-accent);\n  display:flex;align-items:center;justify-content:center;\n}\n.gwq-zoom-icon svg{\n  width:17px;height:17px;\n  fill:none;stroke:var(--gw-ink);stroke-width:2.2;\n  stroke-linecap:round;stroke-linejoin:round;\n}\n\n.gwq-zoom-label{\n  margin:0 0 8px;\n  font-family:'Archivo',system-ui,sans-serif;\n  font-weight:700;font-style:normal;text-transform:uppercase;\n  font-size:clamp(12px,1vw,14px);\n  letter-spacing:.07em;\n}\n.gwq-zoom-spec{\n  margin:0;\n  font-family:'Archivo',system-ui,sans-serif;\n  font-weight:900;font-style:italic;text-transform:uppercase;\n  font-size:clamp(20px,2.2vw,30px);\n  line-height:1.05;letter-spacing:-0.015em;\n}\n.gwq-zoom-hint{\n  margin:8px 0 0;\n  font-family:'Archivo',system-ui,sans-serif;\n  font-weight:500;font-style:normal;font-size:13px;\n  text-decoration:underline;\n  text-underline-offset:3px;\n}\n\n/* ---------- VISIONNEUSE PLEIN ÉCRAN ---------- */\n.gwq-lightbox{\n  position:fixed;\n  inset:0;\n  z-index:99999;\n  background:rgba(0,0,0,.92);\n  display:flex;\n  align-items:center;\n  justify-content:center;\n  padding:24px;\n  cursor:zoom-out;\n}\n.gwq-lightbox[hidden]{display:none;}\n\n/* l'image agrandie reste un cercle */\n.gwq-lightbox img{\n  width:var(--gw-lb-size);\n  height:var(--gw-lb-size);\n  object-fit:cover;\n  object-position:var(--gw-zoom-pos);\n  display:block;\n  border-radius:50%;\n  border:var(--gw-lb-ring) solid var(--gw-accent);\n  box-shadow:0 20px 60px rgba(0,0,0,.6);\n}\n\n.gwq-lightbox-close{\n  position:absolute;\n  top:18px;right:22px;\n  width:46px;height:46px;\n  padding:0;\n  border:none;border-radius:50%;\n  background:var(--gw-accent);\n  display:flex;align-items:center;justify-content:center;\n  cursor:pointer;\n}\n.gwq-lightbox-close svg{\n  width:20px;height:20px;\n  fill:none;stroke:var(--gw-ink);stroke-width:2.6;\n  stroke-linecap:round;\n  display:block;\n}\n\n/* ---------- DESKTOP : image à gauche, texte à droite ---------- */\n@media(min-width:900px){\n  .gwq-inner{\n    grid-template-columns:var(--gw-img-col) 1fr;\n    gap:56px;\n  }\n}\n\n@media(max-width:899px){\n  .gwq{padding:46px 20px 54px;}\n  .gwq{--gw-frame-pad:16px; --gw-zoom-size:128px; --gw-zoom-ring:5px; --gw-zoom-gap:26px; --gw-lb-ring:7px;}\n  .gwq-list{gap:13px;}\n  .gwq-zoom{gap:18px;}\n  .gwq-zoom-icon{width:26px;height:26px;right:5px;bottom:5px;}\n  .gwq-zoom-icon svg{width:14px;height:14px;}\n  .gwq-lightbox-close{top:14px;right:14px;width:42px;height:42px;}\n}\n</style>\n\n<script>\n(function(){\n  var box = document.getElementById('gwqLightbox');\n  if(!box) return;\n  var boxImg = box.querySelector('img');\n  var closeBtn = box.querySelector('.gwq-lightbox-close');\n\n  function open(src, alt){\n    boxImg.src = src;\n    if(alt) boxImg.alt = alt;\n    box.hidden = false;\n    document.body.style.overflow = 'hidden';\n  }\n  function close(){\n    box.hidden = true;\n    boxImg.src = '';\n    document.body.style.overflow = '';\n  }\n\n  document.querySelectorAll('[data-gwq-zoomable]').forEach(function(el){\n    el.addEventListener('click', function(){\n      var inner = el.querySelector('img');\n      open(el.getAttribute('data-gwq-src') || (inner && inner.src), inner && inner.alt);\n    });\n  });\n\n  box.addEventListener('click', function(e){\n    if(e.target !== boxImg) close();\n  });\n\n  document.addEventListener('keydown', function(e){\n    if(e.key === 'Escape' && !box.hidden) close();\n  });\n})();\n</script>",
