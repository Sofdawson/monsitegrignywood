        "remove_horizontal_spacing": true,
        "liquid": "<div class=\"gwp\">\n\n  <h2 class=\"gwp-title\">Quelques photos des projets réalisés</h2>\n\n  <!-- ⚠️ Images de test — remplacez les src par vos photos d'archives.\n       Les 6 images doivent être dupliquées à l'identique dans la 2e série,\n       sinon la boucle saute au raccord. ⚠️ -->\n  <div class=\"gwp-band\">\n    <div class=\"gwp-track\">\n\n      <!-- ── série 1 ── -->\n      <img class=\"gwp-ph\" src=\"https://cdn.shopify.com/s/files/1/0980/1724/7556/files/ChatGPT_Image_13_sept._2026_19_18_09.png?v=1789321172\" alt=\"\" loading=\"lazy\">\n      <img class=\"gwp-ph\" src=\"https://cdn.shopify.com/s/files/1/0980/1724/7556/files/ChatGPT_Image_13_sept._2026_19_31_34.png?v=1789321172\" alt=\"\" loading=\"lazy\">\n      <img class=\"gwp-ph\" src=\"https://cdn.shopify.com/s/files/1/0980/1724/7556/files/ChatGPT_Image_13_sept._2026_19_36_48.png?v=1789321172\" alt=\"\" loading=\"lazy\">\n      <img class=\"gwp-ph\" src=\"https://cdn.shopify.com/s/files/1/0980/1724/7556/files/ChatGPT_Image_13_sept._2026_21_52_39.png?v=1789330585\" alt=\"\" loading=\"lazy\">\n      <img class=\"gwp-ph\" src=\"https://cdn.shopify.com/s/files/1/0980/1724/7556/files/ChatGPT_Image_13_sept._2026_17_19_32.png?v=1789313291\" alt=\"\" loading=\"lazy\">\n      <img class=\"gwp-ph\" src=\"https://cdn.shopify.com/s/files/1/0980/1724/7556/files/ChatGPT_Image_13_sept._2026_19_31_34.png?v=1789321172\" alt=\"\" loading=\"lazy\">\n\n      <!-- ── série 2 : copie identique ── -->\n      <img class=\"gwp-ph\" src=\"https://cdn.shopify.com/s/files/1/0980/1724/7556/files/ChatGPT_Image_13_sept._2026_19_18_09.png?v=1789321172\" alt=\"\" loading=\"lazy\">\n      <img class=\"gwp-ph\" src=\"https://cdn.shopify.com/s/files/1/0980/1724/7556/files/ChatGPT_Image_13_sept._2026_19_31_34.png?v=1789321172\" alt=\"\" loading=\"lazy\">\n      <img class=\"gwp-ph\" src=\"https://cdn.shopify.com/s/files/1/0980/1724/7556/files/ChatGPT_Image_13_sept._2026_19_36_48.png?v=1789321172\" alt=\"\" loading=\"lazy\">\n      <img class=\"gwp-ph\" src=\"https://cdn.shopify.com/s/files/1/0980/1724/7556/files/ChatGPT_Image_13_sept._2026_21_52_39.png?v=1789330585\" alt=\"\" loading=\"lazy\">\n      <img class=\"gwp-ph\" src=\"https://cdn.shopify.com/s/files/1/0980/1724/7556/files/ChatGPT_Image_13_sept._2026_17_19_32.png?v=1789313291\" alt=\"\" loading=\"lazy\">\n      <img class=\"gwp-ph\" src=\"https://cdn.shopify.com/s/files/1/0980/1724/7556/files/ChatGPT_Image_13_sept._2026_19_31_34.png?v=1789321172\" alt=\"\" loading=\"lazy\">\n\n    </div>\n  </div>\n</div>\n\n<style>\n@import url('https://fonts.googleapis.com/css2?family=Archivo:ital,wght@0,700;1,900&display=swap');\n\n.gwp{\n  /* ================= RÉGLAGES ================= */\n  --gw-bg:#FFFFFF;           /* fond de section */\n  --gw-ink:#111111;\n  --gw-neon:#F5C518;         /* orange néon, identique à la section bénéfices */\n  --gw-neon-rgb:245,197,24;\n  --gw-ph-h:330px;           /* hauteur des photos */\n  --gw-ph-w:300px;           /* largeur des photos */\n  --gw-gap:30px;             /* écart entre les photos */\n  --gw-speed:38s;            /* durée d'un cycle : plus grand = plus lent */\n  /* ============================================ */\n\n  width:100vw;\n  max-width:100vw;\n  margin-left:calc(50% - 50vw);\n  margin-right:calc(50% - 50vw);\n  box-sizing:border-box;\n  background:var(--gw-bg);\n  color:var(--gw-ink);\n  padding:56px 0 64px;\n  font-family:'Archivo',system-ui,sans-serif;\n  overflow:hidden;\n}\n\n/* GRAND TITRE DE SECTION — standard commun à tout le site. */\n.gwp-title{\n  font-weight:900;font-style:italic;text-transform:uppercase;\n  text-align:center;color:var(--gw-ink);\n  font-size:clamp(22px,3.4vw,38px);\n  line-height:1.05;letter-spacing:-0.015em;\n  margin:0 0 44px;\n  padding:0 20px;\n}\n\n.gwp-band{\n  width:100%;\n  overflow:hidden;\n  padding:34px 0;          /* dégage la place pour les rotations et les halos */\n}\n\n.gwp-track{\n  display:flex;\n  align-items:center;\n  flex-wrap:nowrap;\n  width:max-content;\n  gap:var(--gw-gap);\n  animation:gwpScroll var(--gw-speed) linear infinite;\n}\n.gwp-track:hover{animation-play-state:paused;}\n\n.gwp-ph{\n  flex:0 0 auto;\n  display:block;\n  width:var(--gw-ph-w);\n  height:var(--gw-ph-h);\n  object-fit:cover;\n  background:#FFFFFF;\n  border:2.5px solid var(--gw-neon);\n  border-radius:10px;\n  box-shadow:\n    0 0 0 1px rgba(var(--gw-neon-rgb),.95),\n    0 0 9px rgba(var(--gw-neon-rgb),.95),\n    0 0 24px rgba(var(--gw-neon-rgb),.62),\n    0 0 44px rgba(var(--gw-neon-rgb),.34);\n}\n\n/* inclinaisons alternées, cycle de 6 pour rester identique sur la copie */\n.gwp-ph:nth-child(6n+1){transform:rotate(-3deg);}\n.gwp-ph:nth-child(6n+2){transform:rotate(2.2deg);}\n.gwp-ph:nth-child(6n+3){transform:rotate(-1.6deg);}\n.gwp-ph:nth-child(6n+4){transform:rotate(3deg);}\n.gwp-ph:nth-child(6n+5){transform:rotate(-2.4deg);}\n.gwp-ph:nth-child(6n+6){transform:rotate(1.4deg);}\n\n@keyframes gwpScroll{\n  from{transform:translateX(0)}\n  to{transform:translateX(-50%)}\n}\n\n@media(prefers-reduced-motion:reduce){\n  .gwp-track{animation:none;}\n}\n\n@media(max-width:749px){\n  .gwp{--gw-ph-h:230px;--gw-ph-w:210px;--gw-gap:18px;--gw-speed:26s;padding:44px 0 50px;}\n  .gwp-title{margin:0 0 30px;}\n  .gwp-band{padding:26px 0;}\n}\n</style>",
