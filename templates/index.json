        "liquid": "<div class=\"gwr\">\n\n  <!-- ══════ INTRO ══════ -->\n  <div class=\"gwr-intro\">\n    <p class=\"gwr-label\">Le t-shirt Grignywood</p>\n\n    <h2 class=\"gwr-title\">\n      Un t-shirt\n      <img src=\"https://cdn.shopify.com/s/files/1/0980/1724/7556/files/ChatGPT_Image_13_sept._2026_19_18_09.png?v=1789321172\" alt=\"\">\n      qui se sent dans la main,\n      <img src=\"https://cdn.shopify.com/s/files/1/0980/1724/7556/files/ChatGPT_Image_13_sept._2026_19_31_34.png?v=1789321172\" alt=\"\">\n      qui se voit dans la rue,\n      <img src=\"https://cdn.shopify.com/s/files/1/0980/1724/7556/files/ChatGPT_Image_13_sept._2026_19_36_48.png?v=1789321172\" alt=\"\">\n      et qui se défend partout.\n    </h2>\n\n    <p class=\"gwr-sub\">Coton lourd 350 g. Coupe oversize. Et des bénéfices qui financent de vrais projets.</p>\n  </div>\n\n  <!-- ══════ MODULE 3 LIGNES ══════ -->\n  <div class=\"gwr-stage\">\n\n    <div class=\"gwr-rows\">\n\n      <article class=\"gwr-row r1\">\n        <div class=\"gwr-txt\">\n          <h3>Ça se sent</h3>\n          <p>350 g de coton lourd. La différence est dans la main, pas sur l'étiquette</p>\n        </div>\n        <img class=\"gwr-thumb\" src=\"https://cdn.shopify.com/s/files/1/0980/1724/7556/files/ChatGPT_Image_13_sept._2026_19_18_09.png?v=1789321172\" alt=\"\" loading=\"lazy\">\n      </article>\n\n      <article class=\"gwr-row r2\">\n        <div class=\"gwr-txt\">\n          <h3>Ça se voit</h3>\n          <p>Coupe oversize, épaules tombantes. On te repère avant de lire le logo</p>\n        </div>\n        <img class=\"gwr-thumb\" src=\"https://cdn.shopify.com/s/files/1/0980/1724/7556/files/ChatGPT_Image_13_sept._2026_19_31_34.png?v=1789321172\" alt=\"\" loading=\"lazy\">\n      </article>\n\n      <article class=\"gwr-row r3\">\n        <div class=\"gwr-txt\">\n          <h3>Ça se défend</h3>\n          <p>Chaque commande finance de vrais projets. Tu sais où va ton argent</p>\n        </div>\n        <img class=\"gwr-thumb\" src=\"https://cdn.shopify.com/s/files/1/0980/1724/7556/files/ChatGPT_Image_13_sept._2026_19_36_48.png?v=1789321172\" alt=\"\" loading=\"lazy\">\n      </article>\n\n    </div>\n\n    <!-- fonds qui basculent au survol (desktop) -->\n    <div class=\"gwr-bgs\" aria-hidden=\"true\">\n      <div class=\"gwr-bg b1\" style=\"background-image:url('https://cdn.shopify.com/s/files/1/0980/1724/7556/files/ChatGPT_Image_13_sept._2026_19_18_09.png?v=1789321172')\"></div>\n      <div class=\"gwr-bg b2\" style=\"background-image:url('https://cdn.shopify.com/s/files/1/0980/1724/7556/files/ChatGPT_Image_13_sept._2026_19_31_34.png?v=1789321172')\"></div>\n      <div class=\"gwr-bg b3\" style=\"background-image:url('https://cdn.shopify.com/s/files/1/0980/1724/7556/files/ChatGPT_Image_13_sept._2026_19_36_48.png?v=1789321172')\"></div>\n      <div class=\"gwr-scrim\"></div>\n    </div>\n\n  </div>\n</div>\n\n<style>\n@import url('https://fonts.googleapis.com/css2?family=Archivo:ital,wght@0,600;1,900&display=swap');\n\n.gwr{\n  /* ================= RÉGLAGES ================= */\n  --gw-orange:#F5C518;\n  --gw-ink:#111111;\n  --gw-white:#FFFFFF;\n  --gw-max:1440px;\n  --gw-scrim:.55;\n  --gw-stage-pad:76px;\n  --gw-card-w:82vw;        /* largeur d'une carte en défilement mobile */\n  /* ============================================ */\n\n  width:100vw;\n  max-width:100vw;\n  margin-left:calc(50% - 50vw);\n  margin-right:calc(50% - 50vw);\n  box-sizing:border-box;\n  font-family:'Archivo',system-ui,sans-serif;\n}\n\n/* ─────────── INTRO ─────────── */\n.gwr-intro{\n  background:var(--gw-orange);\n  color:var(--gw-ink);\n  padding:54px 24px 60px;\n  box-sizing:border-box;\n}\n.gwr-label{\n  max-width:var(--gw-max);margin:0 auto 18px;\n  font-weight:600;font-size:14px;letter-spacing:.06em;\n  text-transform:uppercase;\n}\n.gwr-title{\n  max-width:var(--gw-max);margin:0 auto;\n  font-weight:900;font-style:italic;text-transform:uppercase;\n  font-size:clamp(22px,3.4vw,38px);\n  line-height:1.35;letter-spacing:-0.015em;\n  text-align:left;\n}\n.gwr-title img{\n  display:inline-block;vertical-align:middle;\n  width:clamp(54px,7vw,96px);\n  height:clamp(34px,4.4vw,60px);\n  object-fit:cover;\n  border:2px solid var(--gw-ink);\n  margin:0 .12em;\n  transform:translateY(-.06em);\n}\n.gwr-sub{\n  max-width:var(--gw-max);margin:22px auto 0;\n  font-weight:600;font-size:clamp(14px,1.2vw,17px);line-height:1.5;\n}\n\n/* ─────────── MODULE ─────────── */\n.gwr-stage{position:relative;overflow:hidden;background:var(--gw-ink);}\n\n.gwr-bgs{position:absolute;inset:0;z-index:0;}\n.gwr-bg{\n  position:absolute;inset:0;\n  background-size:cover;background-position:center;\n  opacity:0;transition:opacity .45s ease;\n}\n.gwr-scrim{position:absolute;inset:0;background:rgba(0,0,0,var(--gw-scrim));}\n\n.gwr-rows{\n  position:relative;z-index:1;\n  max-width:var(--gw-max);margin:0 auto;\n  padding:var(--gw-stage-pad) 0;\n  box-sizing:border-box;\n}\n\n.gwr-row{\n  display:flex;align-items:center;justify-content:space-between;gap:24px;\n  padding:30px 24px;\n  border-bottom:1px solid rgba(255,255,255,.35);\n  transition:background .3s ease,color .3s ease;\n}\n.gwr-row:last-child{border-bottom:none;}\n\n.gwr-txt h3{\n  margin:0 0 6px;\n  font-weight:900;font-style:italic;text-transform:uppercase;\n  font-size:clamp(22px,3vw,34px);\n  line-height:1.05;letter-spacing:-0.02em;\n  color:var(--gw-white);\n  transition:color .3s ease;\n}\n.gwr-txt p{\n  margin:0;font-weight:600;font-size:clamp(13px,1.1vw,16px);line-height:1.45;\n  color:rgba(255,255,255,.9);\n  transition:color .3s ease;\n  max-width:52ch;\n}\n.gwr-thumb{\n  flex:0 0 auto;\n  width:clamp(120px,17vw,240px);\n  height:clamp(78px,10vw,140px);\n  object-fit:cover;\n  border:2px solid var(--gw-white);\n  transition:border-color .3s ease;\n}\n\n/* ── survol : la ligne passe en aplat orange, le fond bascule ── */\n@media(hover:hover) and (min-width:900px){\n  .gwr-stage:not(:has(.gwr-row:hover)) .b1{opacity:1;}\n  .gwr-stage:has(.r1:hover) .b1{opacity:1;}\n  .gwr-stage:has(.r2:hover) .b2{opacity:1;}\n  .gwr-stage:has(.r3:hover) .b3{opacity:1;}\n\n  .gwr-row:hover{background:var(--gw-orange);}\n  .gwr-row:hover .gwr-txt h3,\n  .gwr-row:hover .gwr-txt p{color:var(--gw-ink);}\n  .gwr-row:hover .gwr-thumb{border-color:var(--gw-ink);}\n}\n\n/* ─────────── MOBILE : défilement latéral ─────────── */\n@media(max-width:899px){\n  .gwr-intro{padding:38px 20px 42px;}\n  .gwr-title{line-height:1.4;}\n  .gwr-title img{width:58px;height:38px;border-width:2px;}\n\n  .gwr-stage{background:var(--gw-white);}\n  .gwr-bgs{display:none;}\n\n  .gwr-rows{\n    display:flex;\n    flex-direction:row;\n    gap:14px;\n    padding:26px 16px 30px;\n    max-width:none;\n    overflow-x:auto;\n    overflow-y:hidden;\n    scroll-snap-type:x mandatory;\n    -webkit-overflow-scrolling:touch;\n    scrollbar-width:none;\n  }\n  .gwr-rows::-webkit-scrollbar{display:none;}\n\n  .gwr-row{\n    flex:0 0 var(--gw-card-w);\n    scroll-snap-align:center;\n    display:flex;\n    flex-direction:column;\n    align-items:stretch;\n    gap:0;\n    padding:0;\n    border:2px solid var(--gw-ink);\n    border-bottom:2px solid var(--gw-ink);\n    background:var(--gw-orange);\n    overflow:hidden;\n  }\n\n  .gwr-txt{padding:20px 18px;box-sizing:border-box;}\n  .gwr-txt h3{color:var(--gw-ink);font-size:25px;margin:0 0 6px;}\n  .gwr-txt p{color:var(--gw-ink);font-size:14px;max-width:none;}\n\n  .gwr-thumb{\n    flex:0 0 auto;\n    width:100%;\n    height:260px;\n    border:none;\n    border-top:2px solid var(--gw-ink);\n    object-fit:cover;\n  }\n}\n</style>",
