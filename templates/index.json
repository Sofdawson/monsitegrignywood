        "remove_vertical_spacing": true,
        "remove_horizontal_spacing": true,
        "liquid": "<div class=\"gw-press\">\n  <p class=\"gw-press-title\">On nous a vu dans</p>\n\n  <div class=\"gw-viewport\">\n    <div class=\"gw-track\">\n      <div class=\"gw-item\"><img src=\"https://cdn.shopify.com/s/files/1/0980/1724/7556/files/france_tv.png?v=1786025451\" alt=\"France TV\"></div>\n      <div class=\"gw-item\"><img src=\"https://cdn.shopify.com/s/files/1/0980/1724/7556/files/le_monde.png?v=1786025477\" alt=\"Le Monde\"></div>\n      <div class=\"gw-item\"><img src=\"https://cdn.shopify.com/s/files/1/0980/1724/7556/files/bfm_tv.jpg?v=1786025496\" alt=\"BFM TV\"></div>\n      <div class=\"gw-item\"><img src=\"https://cdn.shopify.com/s/files/1/0980/1724/7556/files/Le_Parisien.jpg?v=1786025514\" alt=\"Le Parisien\"></div>\n      <div class=\"gw-item\"><img src=\"https://cdn.shopify.com/s/files/1/0980/1724/7556/files/logo_france_24.png?v=1786025531\" alt=\"France 24\"></div>\n\n      <!-- copie dupliquée pour un défilement fluide -->\n      <div class=\"gw-item\" aria-hidden=\"true\"><img src=\"https://cdn.shopify.com/s/files/1/0980/1724/7556/files/france_tv.png?v=1786025451\" alt=\"\"></div>\n      <div class=\"gw-item\" aria-hidden=\"true\"><img src=\"https://cdn.shopify.com/s/files/1/0980/1724/7556/files/le_monde.png?v=1786025477\" alt=\"\"></div>\n      <div class=\"gw-item\" aria-hidden=\"true\"><img src=\"https://cdn.shopify.com/s/files/1/0980/1724/7556/files/bfm_tv.jpg?v=1786025496\" alt=\"\"></div>\n      <div class=\"gw-item\" aria-hidden=\"true\"><img src=\"https://cdn.shopify.com/s/files/1/0980/1724/7556/files/Le_Parisien.jpg?v=1786025514\" alt=\"\"></div>\n      <div class=\"gw-item\" aria-hidden=\"true\"><img src=\"https://cdn.shopify.com/s/files/1/0980/1724/7556/files/logo_france_24.png?v=1786025531\" alt=\"\"></div>\n    </div>\n  </div>\n</div>\n\n<style>\n@import url('https://fonts.googleapis.com/css2?family=Archivo:ital,wght@1,900&display=swap');\n\n.gw-press{\n  /* ============ RÉGLAGES ============ */\n  --gw-band:#F5C518;      /* fond du bandeau (#FFFFFF pour du blanc) */\n  --gw-ink:#111111;       /* noir de la marque */\n  --gw-card:#FFFFFF;      /* fond des encadrés */\n  --gw-border:3px;        /* épaisseur des contours */\n  --s:0.60;               /* échelle globale des logos */\n  --gw-card-h:108px;      /* hauteur des encadrés */\n  --gw-radius:12px;       /* arrondi des cartes rectangulaires */\n  /* ================================== */\n\n  /* pleine largeur : sort du conteneur du thème */\n  width:100vw;\n  max-width:100vw;\n  margin-left:calc(50% - 50vw);\n  margin-right:calc(50% - 50vw);\n\n  box-sizing:border-box;\n  background:var(--gw-band);\n  border-top:var(--gw-border) solid var(--gw-ink);\n  border-bottom:var(--gw-border) solid var(--gw-ink);\n  padding:26px 0 30px;\n  overflow:hidden;\n}\n\n.gw-press-title{\n  font-family:'Archivo',system-ui,sans-serif;\n  font-weight:900;\n  font-style:italic;\n  text-align:center;\n  color:var(--gw-ink);\n  font-size:clamp(22px,3.4vw,38px);\n  line-height:1.05;\n  letter-spacing:-0.01em;\n  text-transform:uppercase;\n  margin:0 0 22px;\n}\n\n.gw-viewport{overflow:hidden;width:100%;}\n\n.gw-track{\n  display:flex;\n  align-items:center;\n  gap:18px;\n  width:max-content;\n  animation:gwScroll 28s linear infinite;\n}\n.gw-track:hover{animation-play-state:paused;}\n\n.gw-item{\n  flex:0 0 auto;\n  display:flex;\n  align-items:center;\n  justify-content:center;\n  height:var(--gw-card-h);\n  min-width:180px;\n  padding:0 22px;\n  box-sizing:border-box;\n  background:var(--gw-card);\n  border:var(--gw-border) solid var(--gw-ink);\n  border-radius:var(--gw-radius);\n  overflow:hidden;                 /* rien ne dépasse de l'arrondi */\n}\n\n.gw-item img{width:auto;display:block;object-fit:contain;}\n\n/* ---- FORME FIXE PAR MARQUE (cycle de 5, identique sur le doublon) ----\n   Logos larges = rectangle. Logos compacts = pilule.\n   Le padding des pilules dégage la zone courbe : rayon = moitié de la hauteur. */\n.gw-item:nth-child(5n+1){border-radius:999px;padding:0 calc(var(--gw-card-h) * .5);} /* France TV   */\n.gw-item:nth-child(5n+2){border-radius:var(--gw-radius);}                            /* Le Monde    */\n.gw-item:nth-child(5n+3){border-radius:999px;padding:0 calc(var(--gw-card-h) * .5);} /* BFM TV      */\n.gw-item:nth-child(5n+4){border-radius:var(--gw-radius);}                            /* Le Parisien */\n.gw-item:nth-child(5n+5){border-radius:999px;padding:0 calc(var(--gw-card-h) * .5);} /* France 24   */\n\n/* ---- HAUTEUR DE CHAQUE LOGO ----\n   Ajustez ces 5 valeurs à l'œil : chaque fichier a sa propre marge interne. */\n.gw-item:nth-child(5n+1) img{height:calc(90px  * var(--s));} /* France TV   */\n.gw-item:nth-child(5n+2) img{height:calc(150px * var(--s));} /* Le Monde    */\n.gw-item:nth-child(5n+3) img{height:calc(65px  * var(--s));} /* BFM TV      */\n.gw-item:nth-child(5n+4) img{height:calc(150px * var(--s));} /* Le Parisien */\n.gw-item:nth-child(5n+5) img{height:calc(95px  * var(--s));} /* France 24   */\n\n@media(max-width:749px){\n  .gw-press{--s:0.44; --gw-card-h:78px; --gw-border:2px; padding:18px 0 22px;}\n  .gw-press-title{font-size:20px;margin:0 0 14px;}\n  .gw-track{gap:10px;}\n  .gw-item{min-width:110px;padding:0 14px;}\n}\n\n@media(prefers-reduced-motion:reduce){\n  .gw-track{animation:none;}\n}\n\n@keyframes gwScroll{from{transform:translateX(0)}to{transform:translateX(-50%)}}\n</style>",
