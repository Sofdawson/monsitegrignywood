    "custom_liquid_rfCYj3": {
      "type": "custom-liquid",
      "name": "Custom Liquid",
      "settings": {
        "full_width": true,
        "remove_vertical_spacing": true,
        "remove_horizontal_spacing": true,
        "liquid": "<div class=\"gwh\">\n\n  <div class=\"gwh-head\">\n    <h2 class=\"gwh-title\">Notre histoire</h2>\n  </div>\n\n  <!-- ⚠️ Remplacez les 4 src par vos vraies photos d'archives ⚠️ -->\n  <div class=\"gwh-grid\">\n\n    <article class=\"gwh-card\">\n      <img class=\"gwh-img\" src=\"https://cdn.shopify.com/s/files/1/0980/1724/7556/files/ChatGPT_Image_13_sept._2026_19_18_09.png?v=1789321172\" alt=\"\" loading=\"lazy\">\n      <div class=\"gwh-panel\">\n        <span class=\"gwh-step\">Les débuts</span>\n        <h3>Tout commence à la Grande Borne</h3>\n        <p>Une association née à Grigny, qui met la vidéo et le multimédia au service de l'insertion, de la culture et de la citoyenneté.</p>\n      </div>\n    </article>\n\n    <article class=\"gwh-card\">\n      <img class=\"gwh-img\" src=\"https://cdn.shopify.com/s/files/1/0980/1724/7556/files/ChatGPT_Image_13_sept._2026_19_31_34.png?v=1789321172\" alt=\"\" loading=\"lazy\">\n      <div class=\"gwh-panel\">\n        <span class=\"gwh-step\">2017 · 2018</span>\n        <h3>Du rap citoyen à l'Assemblée nationale</h3>\n        <p>Le concours « Maire de la ville » fait rimer rap et citoyenneté. Quatre rappeurs partent enregistrer à New York. L'association est reçue à l'Assemblée nationale.</p>\n      </div>\n    </article>\n\n    <article class=\"gwh-card\">\n      <img class=\"gwh-img\" src=\"https://cdn.shopify.com/s/files/1/0980/1724/7556/files/ChatGPT_Image_13_sept._2026_19_36_48.png?v=1789321172\" alt=\"\" loading=\"lazy\">\n      <div class=\"gwh-panel\">\n        <span class=\"gwh-step\">Le Projet Phénix</span>\n        <h3>Un toit pour celles qui fuient</h3>\n        <p>Des logements d'urgence pour les femmes victimes de violences. Plus de 300 structures partenaires, et déjà 1 500 m² engagés en Essonne.</p>\n      </div>\n    </article>\n\n    <article class=\"gwh-card\">\n      <img class=\"gwh-img\" src=\"https://cdn.shopify.com/s/files/1/0980/1724/7556/files/ChatGPT_Image_13_sept._2026_17_19_32.png?v=1789313291\" alt=\"\" loading=\"lazy\">\n      <div class=\"gwh-panel\">\n        <span class=\"gwh-step\">Aujourd'hui</span>\n        <h3>Un t-shirt qui continue le travail</h3>\n        <p>Plus de vingt ans de terrain tiennent dans ce vêtement. Tu ne portes pas un logo : tu portes ce qu'il y a derrière.</p>\n      </div>\n    </article>\n\n  </div>\n</div>\n\n<style>\n@import url('https://fonts.googleapis.com/css2?family=Archivo:ital,wght@0,600;0,700;1,900&display=swap');\n\n.gwh{\n  /* ================= RÉGLAGES ================= */\n  --gw-bg:#F5C518;          /* fond de section */\n  --gw-panel:#FCEFB4;       /* fond des encadrés texte */\n  --gw-ink:#111111;\n  --gw-border:2px;\n  --gw-max:1760px;\n  --gw-img-h:420px;         /* hauteur des visuels sur desktop */\n  --gw-card-w:82vw;         /* largeur d'une carte en défilement mobile */\n  /* ============================================ */\n\n  width:100vw;\n  max-width:100vw;\n  margin-left:calc(50% - 50vw);\n  margin-right:calc(50% - 50vw);\n  box-sizing:border-box;\n  background:var(--gw-bg);\n  color:var(--gw-ink);\n  padding:56px 24px 64px;\n  font-family:'Archivo',system-ui,sans-serif;\n}\n\n.gwh-head{\n  max-width:var(--gw-max);\n  margin:0 auto 32px;\n}\n\n/* GRAND TITRE DE SECTION — standard commun à tout le site. */\n.gwh-title{\n  font-weight:900;font-style:italic;text-transform:uppercase;\n  text-align:center;\n  color:var(--gw-ink);\n  font-size:clamp(22px,3.4vw,38px);\n  line-height:1.05;letter-spacing:-0.015em;\n  margin:0;\n}\n\n.gwh-grid{\n  display:grid;\n  grid-template-columns:repeat(4,1fr);\n  gap:0;\n  max-width:var(--gw-max);\n  margin:0 auto;\n  border:var(--gw-border) solid var(--gw-ink);\n}\n\n.gwh-card{\n  display:flex;\n  flex-direction:column;\n  border-right:var(--gw-border) solid var(--gw-ink);\n  background:var(--gw-panel);\n  min-width:0;\n}\n.gwh-card:last-child{border-right:none;}\n\n.gwh-img{\n  display:block;\n  width:100%;\n  height:var(--gw-img-h);\n  object-fit:cover;\n  border-bottom:var(--gw-border) solid var(--gw-ink);\n}\n\n.gwh-panel{\n  padding:24px 24px 30px;\n  box-sizing:border-box;\n  flex:1;\n}\n\n.gwh-step{\n  display:block;\n  font-weight:700;font-size:12px;letter-spacing:.09em;\n  text-transform:uppercase;\n  margin-bottom:12px;\n  opacity:.75;\n}\n\n.gwh-panel h3{\n  margin:0 0 12px;\n  font-weight:900;font-style:italic;text-transform:uppercase;\n  font-size:clamp(17px,1.5vw,22px);\n  line-height:1.12;letter-spacing:-0.015em;\n}\n\n.gwh-panel p{\n  margin:0;\n  font-weight:600;font-size:14px;line-height:1.5;\n}\n\n/* --- TABLETTE : 2 colonnes --- */\n@media(min-width:700px) and (max-width:1099px){\n  .gwh{--gw-img-h:320px;}\n  .gwh-grid{grid-template-columns:repeat(2,1fr);}\n  .gwh-card:nth-child(2n){border-right:none;}\n  .gwh-card:nth-child(-n+2){border-bottom:var(--gw-border) solid var(--gw-ink);}\n}\n\n/* --- MOBILE : défilement latéral --- */\n@media(max-width:699px){\n  .gwh{padding:44px 0 50px;--gw-img-h:300px;}\n  .gwh-head{margin:0 20px 24px;}\n\n  .gwh-grid{\n    display:flex;\n    flex-direction:row;\n    gap:14px;\n    max-width:none;\n    padding:0 16px;\n    border:none;\n    overflow-x:auto;\n    overflow-y:hidden;\n    scroll-snap-type:x mandatory;\n    -webkit-overflow-scrolling:touch;\n    scrollbar-width:none;\n  }\n  .gwh-grid::-webkit-scrollbar{display:none;}\n\n  .gwh-card{\n    flex:0 0 var(--gw-card-w);\n    scroll-snap-align:center;\n    border:var(--gw-border) solid var(--gw-ink);\n  }\n  .gwh-panel{padding:20px 20px 26px;}\n}\n</style>",
