        "liquid": "<div class=\"gwm\">\n\n  <!-- ══════ BANDEAU DÉFILANT ══════ -->\n  <div class=\"gwm-band\">\n    <div class=\"gwm-track\">\n      <!-- série 1 -->\n      <span>Le talent est partout</span><i>◆</i>\n      <span>Et ma cité en est plein</span><i>◆</i>\n      <span>Né à Grigny, porté partout</span><i>◆</i>\n      <span>#grignywoodfamily</span><i>◆</i>\n      <!-- série 2 : copie identique, nécessaire au défilement continu -->\n      <span>Le talent est partout</span><i>◆</i>\n      <span>Et ma cité en est plein</span><i>◆</i>\n      <span>Né à Grigny, porté partout</span><i>◆</i>\n      <span>#grignywoodfamily</span><i>◆</i>\n    </div>\n  </div>\n\n  <!-- ══════ IMAGE ══════ -->\n  <img class=\"gwm-img\"\n       src=\"https://cdn.shopify.com/s/files/1/0980/1724/7556/files/ChatGPT_Image_13_sept._2026_21_52_39.png?v=1789330585\"\n       alt=\"La Grignywood Family\" loading=\"lazy\">\n\n</div>\n\n<style>\n@import url('https://fonts.googleapis.com/css2?family=Archivo:ital,wght@1,900&display=swap');\n\n.gwm{\n  /* ================= RÉGLAGES ================= */\n  --gw-band-bg:#111111;     /* fond du bandeau */\n  --gw-band-ink:#F5C518;    /* couleur du texte défilant */\n  --gw-band-h:clamp(52px,6vw,92px);   /* hauteur du bandeau */\n  --gw-speed:26s;           /* durée d'un cycle : plus grand = plus lent */\n  --gw-img-max:none;        /* ex. 620px pour brider la hauteur de l'image */\n  /* ============================================ */\n\n  width:100vw;\n  max-width:100vw;\n  margin-left:calc(50% - 50vw);\n  margin-right:calc(50% - 50vw);\n  box-sizing:border-box;\n  font-family:'Archivo',system-ui,sans-serif;\n  line-height:0;\n}\n\n/* ---------- BANDEAU ---------- */\n.gwm-band{\n  background:var(--gw-band-bg);\n  height:var(--gw-band-h);\n  display:flex;align-items:center;\n  overflow:hidden;\n  width:100%;\n}\n\n.gwm-track{\n  display:flex;\n  align-items:center;\n  flex-wrap:nowrap;\n  width:max-content;\n  animation:gwmScroll var(--gw-speed) linear infinite;\n}\n\n.gwm-track span,\n.gwm-track i{\n  display:block;\n  flex:0 0 auto;\n  color:var(--gw-band-ink);\n  font-weight:900;\n  font-style:italic;\n  text-transform:uppercase;\n  font-size:clamp(19px,3.1vw,42px);\n  line-height:1;\n  letter-spacing:-0.01em;\n  white-space:nowrap;\n  padding:0 22px;\n}\n.gwm-track i{font-size:clamp(11px,1.4vw,18px);opacity:.85;padding:0 6px;}\n\n@keyframes gwmScroll{\n  from{transform:translateX(0)}\n  to{transform:translateX(-50%)}\n}\n\n@media(prefers-reduced-motion:reduce){\n  .gwm-track{animation:none;}\n}\n\n/* ---------- IMAGE ---------- */\n.gwm-img{\n  display:block;\n  width:100%;\n  height:auto;\n  max-height:var(--gw-img-max);\n  object-fit:cover;\n}\n\n@media(max-width:749px){\n  .gwm{--gw-speed:18s;}\n  .gwm-track span,.gwm-track i{padding:0 14px;}\n}\n</style>",
