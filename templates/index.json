    "custom_liquid_rfCYj3": {
      "type": "custom-liquid",
      "name": "Custom Liquid",
      "settings": {
        "full_width": true,
        "remove_vertical_spacing": true,
        "remove_horizontal_spacing": true,
        "liquid": "<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Archivo:ital,wght@0,600;0,700;1,900&display=swap\">\n\n<div class=\"gwh\">\n\n  <div class=\"gwh-head\">\n    <h2 class=\"gwh-title\">Notre histoire</h2>\n  </div>\n\n  <!-- ⚠️ Remplacez les 4 src par vos vraies photos d'archives ⚠️ -->\n  <div class=\"gwh-grid\">\n\n    <article class=\"gwh-card\">\n      <img class=\"gwh-img\" src=\"https://cdn.shopify.com/s/files/1/0980/1724/7556/files/ChatGPT_Image_13_sept._2026_19_18_09.png?v=1789321172\" alt=\"\" loading=\"lazy\">\n      <div class=\"gwh-panel\">\n        <span class=\"gwh-step\">Les débuts</span>\n        <h3>Tout commence à la Grande Borne</h3>\n        <p>Une association née à Grigny, qui met la vidéo et le multimédia au service de l'insertion, de la culture et de la citoyenneté.</p>\n      </div>\n    </article>\n\n    <article class=\"gwh-card\">\n      <img class=\"gwh-img\" src=\"https://cdn.shopify.com/s/files/1/0980/1724/7556/files/ChatGPT_Image_13_sept._2026_19_31_34.png?v=1789321172\" alt=\"\" loading=\"lazy\">\n      <div class=\"gwh-panel\">\n        <span class=\"gwh-step\">2017 · 2018</span>\n        <h3>Du rap citoyen à l'Assemblée nationale</h3>\n        <p>Le concours « Maire de la ville » fait rimer rap et citoyenneté. Quatre rappeurs partent enregistrer à New York. L'association est reçue à l'Assemblée nationale.</p>\n      </div>\n    </article>\n\n    <article class=\"gwh-card\">\n      <img class=\"gwh-img\" src=\"https://cdn.shopify.com/s/files/1/0980/1724/7556/files/ChatGPT_Image_13_sept._2026_19_36_48.png?v=1789321172\" alt=\"\" loading=\"lazy\">\n      <div class=\"gwh-panel\">\n        <span class=\"gwh-step\">Le Projet Phénix</span>\n        <h3>Un toit pour celles qui fuient</h3>\n        <p>Des logements d'urgence pour les femmes victimes de violences. Plus de 300 structures partenaires, et déjà 1 500 m² engagés en Essonne.</p>\n      </div>\n    </article>\n\n    <article class=\"gwh-card\">\n      <img class=\"gwh-img\" src=\"https://cdn.shopify.com/s/files/1/0980/1724/7556/files/ChatGPT_Image_13_sept._2026_17_19_32.png?v=1789313291\" alt=\"\" loading=\"lazy\">\n      <div class=\"gwh-panel\">\n        <span class=\"gwh-step\">Aujourd'hui</span>\n        <h3>Un t-shirt qui continue le travail</h3>\n        <p>Plus de vingt ans de terrain tiennent dans ce vêtement. Tu ne portes pas un logo : tu portes ce qu'il y a derrière.</p>\n      </div>\n    </article>\n\n  </div>\n</div>\n\n<style>\n.gwh{\n  /* ================= RÉGLAGES ================= */\n  --gw-bg:#FFFFFF;          /* fond de section */\n  --gw-panel:#FFFFFF;       /* fond des encadrés texte */\n  --gw-ink:#111111;\n\n  /* ---- CADRE + NÉON — identiques aux autres sections ---- */\n  --gw-frame:#111111;\n  --gw-frame-w:1.5px;\n  --gw-radius:16px;\n  --gw-neon:#F7A81B;\n  --gw-neon-rgb:247,168,27;\n  --gw-halo-0:.45;\n  --gw-halo-1:.50;\n  --gw-halo-2:.32;\n  --gw-halo-3:.18;\n\n  /* ---- CHRONOLOGIE ---- */\n  --gw-rail-y:30px;         /* hauteur du rail dans le panneau texte */\n  --gw-rail-w:2px;          /* épaisseur du rail */\n  --gw-rail-op:.55;         /* opacité du rail */\n  --gw-node:34px;           /* diamètre du jalon numéroté */\n  --gw-rail-x:24px;         /* décalage du jalon depuis la gauche */\n\n  --gw-max:1760px;\n  --gw-img-h:420px;         /* hauteur des visuels sur desktop */\n  --gw-card-w:82vw;         /* largeur d'une carte en défilement mobile */\n  /* ============================================ */\n\n  width:100vw;\n  max-width:100vw;\n  margin-left:calc(50% - 50vw);\n  margin-right:calc(50% - 50vw);\n  box-sizing:border-box;\n  background:var(--gw-bg);\n  color:var(--gw-ink);\n  padding:56px 24px 64px;\n  font-family:'Archivo',system-ui,sans-serif;\n}\n.gwh *{box-sizing:border-box;}\n\n.gwh-head{\n  max-width:var(--gw-max);\n  margin:0 auto 34px;\n}\n\n/* GRAND TITRE DE SECTION — standard commun à tout le site. */\n.gwh-title{\n  font-family:'Archivo',system-ui,sans-serif;\n  font-weight:900;font-style:italic;text-transform:uppercase;\n  text-align:center;\n  color:var(--gw-ink);\n  font-size:clamp(22px,3.4vw,38px);\n  line-height:1.05;letter-spacing:-0.015em;\n  margin:0;\n}\n\n/* ---------- LA BANDE : UN SEUL CADRE, NÉON AUTOUR ---------- */\n.gwh-grid{\n  counter-reset:gwh;\n  display:grid;\n  grid-template-columns:repeat(4,1fr);\n  gap:0;\n  max-width:var(--gw-max);\n  margin:0 auto;\n  background:var(--gw-panel);\n  border:var(--gw-frame-w) solid var(--gw-frame);\n  border-radius:var(--gw-radius);\n  overflow:hidden;\n  box-shadow:\n    0 0 0 1px rgba(var(--gw-neon-rgb),var(--gw-halo-0)),\n    0 0 12px rgba(var(--gw-neon-rgb),var(--gw-halo-1)),\n    0 0 32px rgba(var(--gw-neon-rgb),var(--gw-halo-2)),\n    0 0 62px rgba(var(--gw-neon-rgb),var(--gw-halo-3));\n}\n\n.gwh-card{\n  counter-increment:gwh;\n  display:flex;\n  flex-direction:column;\n  background:var(--gw-panel);\n  border-right:var(--gw-frame-w) solid var(--gw-frame);\n  min-width:0;\n}\n.gwh-card:last-child{border-right:none;}\n\n.gwh-img{\n  display:block;\n  width:100%;\n  height:var(--gw-img-h);\n  object-fit:cover;\n  border-bottom:var(--gw-frame-w) solid var(--gw-frame);\n}\n\n/* ---------- PANNEAU TEXTE + JALON DE CHRONOLOGIE ---------- */\n.gwh-panel{\n  position:relative;\n  padding:calc(var(--gw-rail-y) + 26px) 24px 30px;\n  flex:1;\n}\n\n/* le rail : il déborde de 2 px de chaque côté pour franchir la séparation */\n.gwh-panel::before{\n  content:\"\";\n  position:absolute;\n  top:var(--gw-rail-y);\n  left:-2px;\n  right:-2px;\n  height:var(--gw-rail-w);\n  background:var(--gw-neon);\n  opacity:var(--gw-rail-op);\n}\n\n/* le jalon numéroté, posé sur le rail */\n.gwh-panel::after{\n  content:counter(gwh, decimal-leading-zero);\n  position:absolute;\n  top:var(--gw-rail-y);\n  left:var(--gw-rail-x);\n  transform:translateY(calc(-50% + var(--gw-rail-w) / 2));\n  width:var(--gw-node);\n  height:var(--gw-node);\n  border-radius:50%;\n  background:var(--gw-panel);\n  border:var(--gw-frame-w) solid var(--gw-frame);\n  display:flex;align-items:center;justify-content:center;\n  font-family:'Archivo',system-ui,sans-serif;\n  font-weight:900;font-style:italic;\n  font-size:13px;letter-spacing:-0.02em;\n  color:var(--gw-neon);\n  box-shadow:\n    0 0 0 4px var(--gw-panel),\n    0 0 10px rgba(var(--gw-neon-rgb),var(--gw-halo-1)),\n    0 0 22px rgba(var(--gw-neon-rgb),var(--gw-halo-2));\n}\n\n/* dernière étape : jalon plein, et le rail s'arrête dessus */\n.gwh-card:last-child .gwh-panel::before{\n  right:auto;\n  width:calc(var(--gw-rail-x) + var(--gw-node) / 2 + 2px);\n}\n.gwh-card:last-child .gwh-panel::after{\n  background:var(--gw-neon);\n  color:var(--gw-ink);\n  box-shadow:\n    0 0 0 4px var(--gw-panel),\n    0 0 12px rgba(var(--gw-neon-rgb),.8),\n    0 0 28px rgba(var(--gw-neon-rgb),.45);\n}\n\n.gwh-step{\n  display:block;\n  font-family:'Archivo',system-ui,sans-serif;\n  font-weight:700;font-style:normal;font-size:12px;letter-spacing:.09em;\n  text-transform:uppercase;\n  margin-bottom:12px;\n  color:var(--gw-neon);\n}\n\n.gwh-panel h3{\n  margin:0 0 12px;\n  font-family:'Archivo',system-ui,sans-serif;\n  font-weight:900;font-style:italic;text-transform:uppercase;\n  font-size:clamp(17px,1.5vw,22px);\n  line-height:1.12;letter-spacing:-0.015em;\n  color:var(--gw-ink);\n}\n\n.gwh-panel p{\n  margin:0;\n  font-family:'Archivo',system-ui,sans-serif;\n  font-weight:600;font-style:normal;\n  font-size:14px;line-height:1.5;\n  color:var(--gw-ink);\n}\n\n/* --- TABLETTE : 2 colonnes --- */\n@media(min-width:700px) and (max-width:1099px){\n  .gwh{--gw-img-h:320px;}\n  .gwh-grid{grid-template-columns:repeat(2,1fr);}\n  .gwh-card:nth-child(2n){border-right:none;}\n  .gwh-card:nth-child(-n+2){border-bottom:var(--gw-frame-w) solid var(--gw-frame);}\n}\n\n/* --- MOBILE : défilement latéral, la bande reste d'un seul tenant --- */\n@media(max-width:699px){\n  .gwh{padding:44px 16px 50px;--gw-img-h:300px;--gw-radius:12px;--gw-rail-x:20px;--gw-node:30px;}\n  .gwh-head{margin:0 4px 26px;}\n\n  .gwh-grid{\n    display:flex;\n    flex-direction:row;\n    gap:0;\n    max-width:none;\n    overflow-x:auto;\n    overflow-y:hidden;\n    scroll-snap-type:x mandatory;\n    -webkit-overflow-scrolling:touch;\n    scrollbar-width:none;\n  }\n  .gwh-grid::-webkit-scrollbar{display:none;}\n\n  .gwh-card{\n    flex:0 0 var(--gw-card-w);\n    scroll-snap-align:start;\n  }\n  .gwh-panel{padding:calc(var(--gw-rail-y) + 22px) 20px 26px;}\n}\n</style>",
        "background": "",
        "background_gradient": "",
        "text_color": ""
      }
    },
    "custom_liquid_3cGWek": {
      "type": "custom-liquid",
      "name": "Custom Liquid",
      "settings": {
        "full_width": true,
        "remove_vertical_spacing": true,
        "remove_horizontal_spacing": true,
        "liquid": "<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Archivo:ital,wght@0,700;1,900&display=swap\">\n\n<div class=\"gwp\">\n\n  <h2 class=\"gwp-title\">Quelques photos des projets réalisés</h2>\n\n  <!-- ⚠️ Images de test — remplacez les src par vos photos d'archives.\n       Les 6 images doivent être dupliquées à l'identique dans la 2e série,\n       sinon la boucle saute au raccord. ⚠️ -->\n  <div class=\"gwp-band\">\n    <div class=\"gwp-track\">\n\n      <!-- ── série 1 ── -->\n      <img class=\"gwp-ph\" src=\"https://cdn.shopify.com/s/files/1/0980/1724/7556/files/ChatGPT_Image_13_sept._2026_19_18_09.png?v=1789321172\" alt=\"\" loading=\"lazy\">\n      <img class=\"gwp-ph\" src=\"https://cdn.shopify.com/s/files/1/0980/1724/7556/files/ChatGPT_Image_13_sept._2026_19_31_34.png?v=1789321172\" alt=\"\" loading=\"lazy\">\n      <img class=\"gwp-ph\" src=\"https://cdn.shopify.com/s/files/1/0980/1724/7556/files/ChatGPT_Image_13_sept._2026_19_36_48.png?v=1789321172\" alt=\"\" loading=\"lazy\">\n      <img class=\"gwp-ph\" src=\"https://cdn.shopify.com/s/files/1/0980/1724/7556/files/ChatGPT_Image_13_sept._2026_21_52_39.png?v=1789330585\" alt=\"\" loading=\"lazy\">\n      <img class=\"gwp-ph\" src=\"https://cdn.shopify.com/s/files/1/0980/1724/7556/files/ChatGPT_Image_13_sept._2026_17_19_32.png?v=1789313291\" alt=\"\" loading=\"lazy\">\n      <img class=\"gwp-ph\" src=\"https://cdn.shopify.com/s/files/1/0980/1724/7556/files/ChatGPT_Image_13_sept._2026_19_31_34.png?v=1789321172\" alt=\"\" loading=\"lazy\">\n\n      <!-- ── série 2 : copie identique ── -->\n      <img class=\"gwp-ph\" src=\"https://cdn.shopify.com/s/files/1/0980/1724/7556/files/ChatGPT_Image_13_sept._2026_19_18_09.png?v=1789321172\" alt=\"\" loading=\"lazy\">\n      <img class=\"gwp-ph\" src=\"https://cdn.shopify.com/s/files/1/0980/1724/7556/files/ChatGPT_Image_13_sept._2026_19_31_34.png?v=1789321172\" alt=\"\" loading=\"lazy\">\n      <img class=\"gwp-ph\" src=\"https://cdn.shopify.com/s/files/1/0980/1724/7556/files/ChatGPT_Image_13_sept._2026_19_36_48.png?v=1789321172\" alt=\"\" loading=\"lazy\">\n      <img class=\"gwp-ph\" src=\"https://cdn.shopify.com/s/files/1/0980/1724/7556/files/ChatGPT_Image_13_sept._2026_21_52_39.png?v=1789330585\" alt=\"\" loading=\"lazy\">\n      <img class=\"gwp-ph\" src=\"https://cdn.shopify.com/s/files/1/0980/1724/7556/files/ChatGPT_Image_13_sept._2026_17_19_32.png?v=1789313291\" alt=\"\" loading=\"lazy\">\n      <img class=\"gwp-ph\" src=\"https://cdn.shopify.com/s/files/1/0980/1724/7556/files/ChatGPT_Image_13_sept._2026_19_31_34.png?v=1789321172\" alt=\"\" loading=\"lazy\">\n\n    </div>\n  </div>\n</div>\n\n<style>\n.gwp{\n  /* ================= RÉGLAGES ================= */\n  --gw-bg:#FFFFFF;           /* fond de section */\n  --gw-ink:#111111;\n\n  /* ---- CADRE + NÉON — identiques aux autres sections ---- */\n  --gw-frame:#111111;\n  --gw-frame-w:1.5px;\n  --gw-radius:14px;\n  --gw-neon:#F7A81B;\n  --gw-neon-rgb:247,168,27;\n  --gw-halo-0:.45;\n  --gw-halo-1:.50;\n  --gw-halo-2:.32;\n  --gw-halo-3:.18;\n\n  --gw-ph-h:330px;           /* hauteur des photos */\n  --gw-ph-w:300px;           /* largeur des photos */\n  --gw-gap:30px;             /* écart entre les photos */\n  --gw-speed:38s;            /* durée d'un cycle : plus grand = plus lent */\n  /* ============================================ */\n\n  width:100vw;\n  max-width:100vw;\n  margin-left:calc(50% - 50vw);\n  margin-right:calc(50% - 50vw);\n  box-sizing:border-box;\n  background:var(--gw-bg);\n  color:var(--gw-ink);\n  padding:56px 0 64px;\n  font-family:'Archivo',system-ui,sans-serif;\n  overflow:hidden;\n}\n.gwp *{box-sizing:border-box;}\n\n/* GRAND TITRE DE SECTION — standard commun à tout le site. */\n.gwp-title{\n  font-family:'Archivo',system-ui,sans-serif;\n  font-weight:900;font-style:italic;text-transform:uppercase;\n  text-align:center;color:var(--gw-ink);\n  font-size:clamp(22px,3.4vw,38px);\n  line-height:1.05;letter-spacing:-0.015em;\n  margin:0 0 44px;\n  padding:0 20px;\n}\n\n.gwp-band{\n  width:100%;\n  overflow:hidden;\n  padding:34px 0;          /* dégage la place pour les rotations et les halos */\n}\n\n.gwp-track{\n  display:flex;\n  align-items:center;\n  flex-wrap:nowrap;\n  width:max-content;\n  gap:var(--gw-gap);\n  animation:gwpScroll var(--gw-speed) linear infinite;\n}\n.gwp-track:hover{animation-play-state:paused;}\n\n.gwp-ph{\n  flex:0 0 auto;\n  display:block;\n  width:var(--gw-ph-w);\n  height:var(--gw-ph-h);\n  object-fit:cover;\n  background:#FFFFFF;\n  border:var(--gw-frame-w) solid var(--gw-frame);\n  border-radius:var(--gw-radius);\n  box-shadow:\n    0 0 0 1px rgba(var(--gw-neon-rgb),var(--gw-halo-0)),\n    0 0 10px rgba(var(--gw-neon-rgb),var(--gw-halo-1)),\n    0 0 26px rgba(var(--gw-neon-rgb),var(--gw-halo-2)),\n    0 0 52px rgba(var(--gw-neon-rgb),var(--gw-halo-3));\n}\n\n/* inclinaisons alternées, cycle de 6 pour rester identique sur la copie */\n.gwp-ph:nth-child(6n+1){transform:rotate(-3deg);}\n.gwp-ph:nth-child(6n+2){transform:rotate(2.2deg);}\n.gwp-ph:nth-child(6n+3){transform:rotate(-1.6deg);}\n.gwp-ph:nth-child(6n+4){transform:rotate(3deg);}\n.gwp-ph:nth-child(6n+5){transform:rotate(-2.4deg);}\n.gwp-ph:nth-child(6n+6){transform:rotate(1.4deg);}\n\n@keyframes gwpScroll{\n  from{transform:translateX(0)}\n  to{transform:translateX(-50%)}\n}\n\n@media(prefers-reduced-motion:reduce){\n  .gwp-track{animation:none;}\n}\n\n@media(max-width:749px){\n  .gwp{--gw-ph-h:230px;--gw-ph-w:210px;--gw-gap:18px;--gw-speed:26s;--gw-radius:12px;padding:44px 0 50px;}\n  .gwp-title{margin:0 0 30px;}\n  .gwp-band{padding:26px 0;}\n}\n</style>",
