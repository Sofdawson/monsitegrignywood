        "liquid": "<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Archivo:ital,wght@0,600;1,900&display=swap\">\n\n<div class=\"gwr\">\n\n  <!-- ══════ INTRO ══════ -->\n  <div class=\"gwr-intro\">\n    <p class=\"gwr-label\">Le t-shirt Grignywood</p>\n\n    <h2 class=\"gwr-title\">\n      Un t-shirt qui se défend partout, qui se voit dans la rue, et qui se sent dans la main.\n    </h2>\n\n    <p class=\"gwr-sub\">Des bénéfices qui financent de vrais projets. Coupe oversize. Coton lourd 350 g.</p>\n  </div>\n\n  <!-- ══════ MODULE 3 LIGNES ══════ -->\n  <div class=\"gwr-stage\">\n\n    <div class=\"gwr-rows\">\n\n      <article class=\"gwr-row r1\">\n        <div class=\"gwr-txt\">\n          <h3>Ça se défend</h3>\n          <p>Chaque commande finance de vrais projets. Tu sais où va ton argent</p>\n        </div>\n        <img class=\"gwr-thumb\" src=\"https://cdn.shopify.com/s/files/1/0980/1724/7556/files/ChatGPT_Image_13_sept._2026_19_36_48.png?v=1789321172\" alt=\"\" loading=\"lazy\">\n      </article>\n\n      <article class=\"gwr-row r2\">\n        <div class=\"gwr-txt\">\n          <h3>Ça se voit</h3>\n          <p>Coupe oversize, épaules tombantes. On te repère avant de lire le logo</p>\n        </div>\n        <img class=\"gwr-thumb\" src=\"https://cdn.shopify.com/s/files/1/0980/1724/7556/files/ChatGPT_Image_18_sept._2026_21_53_35.png?v=1789762064\" alt=\"\" loading=\"lazy\">\n      </article>\n\n      <article class=\"gwr-row r3\">\n        <div class=\"gwr-txt\">\n          <h3>Ça se sent</h3>\n          <p>350 g de coton lourd. La différence est dans la main, pas sur l'étiquette</p>\n        </div>\n        <img class=\"gwr-thumb\" src=\"https://cdn.shopify.com/s/files/1/0980/1724/7556/files/ChatGPT_Image_18_sept._2026_22_04_07.png?v=1789762064\" alt=\"\" loading=\"lazy\">\n      </article>\n\n    </div>\n\n    <div class=\"gwr-bgs\" aria-hidden=\"true\">\n      <div class=\"gwr-bg b1\" style=\"background-image:url('https://cdn.shopify.com/s/files/1/0980/1724/7556/files/ChatGPT_Image_13_sept._2026_19_36_48.png?v=1789321172')\"></div>\n      <div class=\"gwr-bg b2\" style=\"background-image:url('https://cdn.shopify.com/s/files/1/0980/1724/7556/files/ChatGPT_Image_18_sept._2026_21_53_35.png?v=1789762064')\"></div>\n      <div class=\"gwr-bg b3\" style=\"background-image:url('https://cdn.shopify.com/s/files/1/0980/1724/7556/files/ChatGPT_Image_18_sept._2026_22_04_07.png?v=1789762064')\"></div>\n      <div class=\"gwr-scrim\"></div>\n    </div>\n\n  </div>\n</div>\n\n<style>\n.gwr{\n  --gw-orange:#F5C518;\n  --gw-ink:#111111;\n  --gw-white:#FFFFFF;\n  --gw-intro-bg:#FFFFFF;\n  --gw-max:1440px;\n  --gw-scrim:.55;\n  --gw-stage-pad:76px;\n  --gw-card-w:82vw;\n\n  --gw-frame:#111111;\n  --gw-frame-w:1.5px;\n  --gw-card-radius:14px;\n\n  --gw-neon:#F7A81B;\n  --gw-neon-rgb:247,168,27;\n  --gw-halo-0:.45;\n  --gw-halo-1:.50;\n  --gw-halo-2:.32;\n  --gw-halo-3:.18;\n\n  width:100vw;\n  max-width:100vw;\n  margin-left:calc(50% - 50vw);\n  margin-right:calc(50% - 50vw);\n  box-sizing:border-box;\n  font-family:'Archivo',system-ui,sans-serif;\n}\n.gwr *{box-sizing:border-box;}\n\n.gwr-intro{\n  background:var(--gw-intro-bg);\n  color:var(--gw-ink);\n  padding:54px 24px 60px;\n}\n.gwr-label{\n  max-width:var(--gw-max);margin:0 auto 18px;\n  font-family:'Archivo',system-ui,sans-serif;\n  font-weight:600;font-size:14px;letter-spacing:.06em;\n  font-style:normal;text-transform:uppercase;\n  color:var(--gw-ink);\n}\n.gwr-title{\n  max-width:var(--gw-max);margin:0 auto;\n  font-family:'Archivo',system-ui,sans-serif;\n  font-weight:900;font-style:italic;text-transform:uppercase;\n  font-size:clamp(22px,3.4vw,38px);\n  line-height:1.15;letter-spacing:-0.015em;\n  text-align:left;color:var(--gw-ink);\n}\n.gwr-sub{\n  max-width:var(--gw-max);margin:22px auto 0;\n  font-family:'Archivo',system-ui,sans-serif;\n  font-weight:600;font-style:normal;\n  font-size:clamp(14px,1.2vw,17px);line-height:1.5;\n  color:var(--gw-ink);\n}\n\n.gwr-stage{position:relative;overflow:hidden;background:var(--gw-ink);}\n\n.gwr-bgs{position:absolute;inset:0;z-index:0;}\n.gwr-bg{\n  position:absolute;inset:0;\n  background-size:cover;background-position:center;\n  opacity:0;transition:opacity .45s ease;\n}\n.gwr-scrim{position:absolute;inset:0;background:rgba(0,0,0,var(--gw-scrim));}\n\n.gwr-rows{\n  position:relative;z-index:1;\n  max-width:var(--gw-max);margin:0 auto;\n  padding:var(--gw-stage-pad) 0;\n}\n\n.gwr-row{\n  display:flex;align-items:center;justify-content:space-between;gap:24px;\n  padding:30px 24px;\n  border-bottom:1px solid rgba(255,255,255,.35);\n  transition:background .3s ease,color .3s ease;\n}\n.gwr-row:last-child{border-bottom:none;}\n\n.gwr-txt h3{\n  margin:0 0 6px;\n  font-family:'Archivo',system-ui,sans-serif;\n  font-weight:900;font-style:italic;text-transform:uppercase;\n  font-size:clamp(22px,3vw,34px);\n  line-height:1.05;letter-spacing:-0.02em;\n  color:var(--gw-white);\n  transition:color .3s ease;\n}\n.gwr-txt p{\n  margin:0;\n  font-family:'Archivo',system-ui,sans-serif;\n  font-weight:600;font-style:normal;\n  font-size:clamp(13px,1.1vw,16px);line-height:1.45;\n  color:rgba(255,255,255,.9);\n  transition:color .3s ease;\n  max-width:52ch;\n}\n.gwr-thumb{\n  flex:0 0 auto;\n  width:clamp(120px,17vw,240px);\n  height:clamp(78px,10vw,140px);\n  object-fit:cover;\n  border:2px solid var(--gw-white);\n  transition:border-color .3s ease;\n}\n\n@media(hover:hover) and (min-width:900px){\n  .gwr-stage:not(:has(.gwr-row:hover)) .b1{opacity:1;}\n  .gwr-stage:has(.r1:hover) .b1{opacity:1;}\n  .gwr-stage:has(.r2:hover) .b2{opacity:1;}\n  .gwr-stage:has(.r3:hover) .b3{opacity:1;}\n\n  .gwr-row:hover{background:var(--gw-orange);}\n  .gwr-row:hover .gwr-txt h3,\n  .gwr-row:hover .gwr-txt p{color:var(--gw-ink);}\n  .gwr-row:hover .gwr-thumb{border-color:var(--gw-ink);}\n}\n\n@media(max-width:899px){\n  .gwr-intro{padding:38px 20px 42px;}\n  .gwr-title{line-height:1.2;}\n\n  .gwr-stage{background:var(--gw-white);}\n  .gwr-bgs{display:none;}\n\n  .gwr-rows{\n    display:flex;\n    flex-direction:row;\n    gap:20px;\n    padding:28px 16px 34px;\n    max-width:none;\n    overflow-x:auto;\n    overflow-y:hidden;\n    scroll-snap-type:x mandatory;\n    -webkit-overflow-scrolling:touch;\n    scrollbar-width:none;\n  }\n  .gwr-rows::-webkit-scrollbar{display:none;}\n\n  .gwr-row{\n    flex:0 0 var(--gw-card-w);\n    scroll-snap-align:center;\n    display:flex;\n    flex-direction:column;\n    align-items:stretch;\n    gap:0;\n    padding:0;\n    border:var(--gw-frame-w) solid var(--gw-frame);\n    border-radius:var(--gw-card-radius);\n    background:var(--gw-ink);\n    overflow:hidden;\n    transition:background .35s ease;\n    box-shadow:\n      0 0 0 1px rgba(var(--gw-neon-rgb),var(--gw-halo-0)),\n      0 0 10px rgba(var(--gw-neon-rgb),var(--gw-halo-1)),\n      0 0 26px rgba(var(--gw-neon-rgb),var(--gw-halo-2)),\n      0 0 52px rgba(var(--gw-neon-rgb),var(--gw-halo-3));\n  }\n\n  .gwr-txt{padding:20px 18px;}\n  .gwr-txt h3{color:var(--gw-white);font-size:25px;margin:0 0 6px;}\n  .gwr-txt p{color:rgba(255,255,255,.9);font-size:14px;max-width:none;}\n\n  .gwr-thumb{\n    flex:0 0 auto;\n    width:100%;\n    height:260px;\n    border:none;\n    border-top:var(--gw-frame-w) solid var(--gw-frame);\n    object-fit:cover;\n  }\n\n  .gwr-row.is-active{background:var(--gw-orange);}\n  .gwr-row.is-active .gwr-txt h3,\n  .gwr-row.is-active .gwr-txt p{color:var(--gw-ink);}\n}\n</style>\n\n<script>\n(function(){\n  var scroller = document.querySelector('.gwr-rows');\n  var rows = document.querySelectorAll('.gwr-row');\n  if(!scroller || !rows.length || !('IntersectionObserver' in window)) return;\n\n  rows[0].classList.add('is-active');\n\n  var io = new IntersectionObserver(function(entries){\n    entries.forEach(function(entry){\n      if(entry.isIntersecting && entry.intersectionRatio >= 0.55){\n        rows.forEach(function(r){ r.classList.remove('is-active'); });\n        entry.target.classList.add('is-active');\n      }\n    });\n  }, { root: scroller, threshold: [0.55] });\n\n  rows.forEach(function(r){ io.observe(r); });\n})();\n</script>",
