        "liquid": "{%- comment -%} ===== GRIGNYWOOD — BANDEAU RÉASSURANCE ===== {%- endcomment -%}\n\n{%- assign gws_freeship = '50 €' -%}\n\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Archivo:ital,wght@0,500;0,700;1,900&display=swap\">\n\n<div class=\"gws\" id=\"gws-{{ section.id }}\">\n  <div class=\"gws-grid\">\n\n    <article class=\"gws-item\">\n      <i class=\"gws-ic\" aria-hidden=\"true\">\n        <svg viewBox=\"0 0 24 24\">\n          <path d=\"M12 3.2 20.2 7.6v8.8L12 20.8 3.8 16.4V7.6z\"/>\n          <path d=\"M3.8 7.6 12 12l8.2-4.4\"/>\n          <path d=\"M12 12v8.8\"/>\n        </svg>\n      </i>\n      <div class=\"gws-txt\">\n        <h3>Livraison offerte dès {{ gws_freeship }}</h3>\n        <p>Colis suivi, préparé et posté depuis l'Essonne.</p>\n      </div>\n    </article>\n\n    <article class=\"gws-item\">\n      <i class=\"gws-ic\" aria-hidden=\"true\">\n        <svg viewBox=\"0 0 24 24\">\n          <path d=\"M4.4 9.3h12.2\"/>\n          <path d=\"M13.6 6.1 16.8 9.3 13.6 12.5\"/>\n          <path d=\"M19.6 14.7H7.4\"/>\n          <path d=\"M10.4 17.9 7.2 14.7 10.4 11.5\"/>\n        </svg>\n      </i>\n      <div class=\"gws-txt\">\n        <h3>Échange ou remboursement</h3>\n        <p>14 jours pour changer d'avis, article non porté.</p>\n      </div>\n    </article>\n\n    <article class=\"gws-item\">\n      <i class=\"gws-ic\" aria-hidden=\"true\">\n        <svg viewBox=\"0 0 24 24\">\n          <path d=\"M20.4 12.1c0 3.8-3.7 6.9-8.4 6.9-1 0-2-.14-2.9-.4L4.2 20.3l1.5-3.5A6.5 6.5 0 0 1 3.6 12.1c0-3.8 3.8-6.9 8.4-6.9s8.4 3.1 8.4 6.9z\"/>\n          <path d=\"M8.8 11.9h.01M12 11.9h.01M15.2 11.9h.01\"/>\n        </svg>\n      </i>\n      <div class=\"gws-txt\">\n        <h3>On répond nous-mêmes</h3>\n        <p>Une vraie personne, pas un robot. Réponse sous 24 h.</p>\n      </div>\n    </article>\n\n    <article class=\"gws-item\">\n      <i class=\"gws-ic\" aria-hidden=\"true\">\n        <svg viewBox=\"0 0 24 24\">\n          <rect x=\"4.6\" y=\"10.3\" width=\"14.8\" height=\"9.5\" rx=\"2.2\"/>\n          <path d=\"M8.4 10.3V7.8a3.6 3.6 0 0 1 7.2 0v2.5\"/>\n          <path d=\"M12 14.2v2\"/>\n        </svg>\n      </i>\n      <div class=\"gws-txt\">\n        <h3>Paiement sécurisé</h3>\n        <p>Transaction chiffrée. Tes données ne transitent pas par nous.</p>\n      </div>\n    </article>\n\n  </div>\n</div>\n\n<style>\n#gws-{{ section.id }}{\n  /* ================= RÉGLAGES ================= */\n  --gw-bg:#FFFFFF;\n  --gw-ink:#111111;\n  --gw-muted:#5A5A5A;\n\n  /* ---- CADRE ---- */\n  --gw-frame:#111111;\n  --gw-frame-w:1.5px;\n  --gw-radius:14px;\n\n  /* ---- NÉON : DÉSACTIVÉ (cohérent avec le reste du site) ---- */\n  --gw-neon:#F7A81B;\n  --gw-neon-rgb:247,168,27;\n  --gw-halo-0:0;\n  --gw-halo-1:0;\n  --gw-halo-2:0;\n  --gw-halo-3:0;\n\n  /* ---- PASTILLES ---- */\n  --gw-ic-size:46px;\n  --gw-ic-bg:rgba(247,168,27,.11);\n  --gw-ic-ring:rgba(247,168,27,.30);\n  --gw-ic-stroke:1.7;\n\n  --gw-max:1360px;\n  --gw-gap:18px;\n  --gw-card-w:68vw;          /* largeur d'une carte en défilement mobile */\n  /* ============================================ */\n\n  width:100vw;\n  max-width:100vw;\n  margin-left:calc(50% - 50vw);\n  margin-right:calc(50% - 50vw);\n  box-sizing:border-box;\n  background:var(--gw-bg);\n  color:var(--gw-ink);\n  padding:44px 24px 48px;\n  font-family:'Archivo',system-ui,sans-serif;\n}\n#gws-{{ section.id }} *{box-sizing:border-box;}\n\n.gws-grid{\n  max-width:var(--gw-max);\n  margin:0 auto;\n  display:grid;\n  grid-template-columns:repeat(4,1fr);\n  gap:var(--gw-gap);\n  align-items:stretch;\n}\n\n.gws-item{\n  display:flex;\n  flex-direction:column;\n  align-items:center;\n  text-align:center;\n  gap:14px;\n  padding:26px 20px 24px;\n  background:#FFFFFF;\n  border:var(--gw-frame-w) solid var(--gw-frame);\n  border-radius:var(--gw-radius);\n  box-shadow:\n    0 0 0 1px rgba(var(--gw-neon-rgb),var(--gw-halo-0)),\n    0 0 10px rgba(var(--gw-neon-rgb),var(--gw-halo-1)),\n    0 0 26px rgba(var(--gw-neon-rgb),var(--gw-halo-2)),\n    0 0 52px rgba(var(--gw-neon-rgb),var(--gw-halo-3));\n}\n\n.gws-ic{\n  flex:0 0 auto;\n  width:var(--gw-ic-size);\n  height:var(--gw-ic-size);\n  border-radius:999px;\n  background:var(--gw-ic-bg);\n  box-shadow:inset 0 0 0 1px var(--gw-ic-ring);\n  display:flex;align-items:center;justify-content:center;\n}\n.gws-ic svg{\n  width:56%;height:56%;\n  display:block;\n  fill:none;\n  stroke:var(--gw-neon);\n  stroke-width:var(--gw-ic-stroke);\n  stroke-linecap:round;\n  stroke-linejoin:round;\n  vector-effect:non-scaling-stroke;\n  shape-rendering:geometricPrecision;\n}\n\n.gws-txt{min-width:0;}\n\n.gws-item h3{\n  margin:0 0 7px;\n  font-family:'Archivo',system-ui,sans-serif;\n  font-weight:900;font-style:italic;text-transform:uppercase;\n  font-size:clamp(14px,1.25vw,17px);\n  line-height:1.15;letter-spacing:-0.015em;\n  color:var(--gw-ink);\n  text-wrap:balance;\n}\n.gws-item p{\n  margin:0;\n  font-family:'Archivo',system-ui,sans-serif;\n  font-weight:500;font-style:normal;\n  font-size:clamp(12.5px,1vw,14px);\n  line-height:1.5;\n  color:var(--gw-muted);\n  text-wrap:pretty;\n}\n\n/* ---------- TABLETTE : 2 colonnes ---------- */\n@media(max-width:1099px) and (min-width:700px){\n  .gws-grid{grid-template-columns:repeat(2,1fr);}\n}\n\n/* ---------- MOBILE : défilement latéral ---------- */\n@media(max-width:699px){\n  #gws-{{ section.id }}{\n    padding:34px 0 40px;\n    --gw-ic-size:42px;\n    --gw-radius:12px;\n  }\n\n  .gws-grid{\n    display:flex;\n    flex-direction:row;\n    gap:14px;\n    max-width:none;\n    padding:4px 16px 10px;\n    overflow-x:auto;\n    overflow-y:hidden;\n    scroll-snap-type:x mandatory;\n    -webkit-overflow-scrolling:touch;\n    scrollbar-width:none;\n    touch-action:pan-x pan-y;\n  }\n  .gws-grid::-webkit-scrollbar{display:none;}\n\n  .gws-item{\n    flex:0 0 var(--gw-card-w);\n    scroll-snap-align:center;\n    padding:22px 18px 20px;\n    gap:12px;\n  }\n  .gws-item h3{font-size:15px;margin:0 0 5px;}\n  .gws-item p{font-size:13px;}\n}\n</style>",
